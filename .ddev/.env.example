# Copy this file to .ddev/.env and fill in your API key.
# These environment variables are available inside DDEV containers.

# Required: Gemini API key for AI features
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Override service hostnames (defaults are for DDEV)
# SOLR_HOST=solr
# SOLR_PORT=8983
# SOLR_CORE=drupal
# SOLR_USER=solr
# SOLR_PASS=SolrRocks
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333

# Lane DDEV relayer (25-09). `bash scripts/ddev-relayer.sh enable` fills these in for you, plus
# .ddev/.env.relayer (anvil's dev key only). Leave empty when the relayer is not enabled.
SPONSOR_RELAYER_URL=
SPONSOR_RELAYER_TOKEN=
