# Composer-managed code is installed (and patched) by the builder's composer
# install. `COPY html/ html/` must never lay a local or committed copy over it:
# that silently undoes patches/ (see scripts/ops/tests/no-tracked-contrib.test.sh).
html/core/
html/modules/contrib/
html/profiles/contrib/
html/themes/contrib/
html/libraries/

# Pack source copies (members-only demo text and expected answers) are test material; Apache would serve .md files.
html/modules/custom/localnodes_demo_packs/tests/fixtures/expect/*/source.md
