# Settings for running LocalNodes with Docker Compose on your own server.
# docs/SELF-HOST.md walks through it. Copy this file to .env, fill it in, and
# keep .env private (chmod 600 .env): it holds your passwords and keys.

# --- Set these before the first start -------------------------------------

# Passwords for the site's own database, and the hash salt. Make each one
# random, once (for example: openssl rand -hex 32), and never change them
# after the first start.
DB_PASSWORD=
DB_ROOT_PASSWORD=
DRUPAL_HASH_SALT=

# The domain people will use, without https:// (for example
# community.example.org). While you try the site on the server's own
# address, put that address here instead (for example 203.0.113.7).
SERVICE_FQDN_OPENSOCIAL=

# The full address people open, with https:// (for example
# https://community.example.org). Links in the site's mail use it. While you
# try the site on the server's own address, put that here instead (for
# example http://203.0.113.7:8080).
SERVICE_URL_OPENSOCIAL=

# The site's name, and the email address of its first administrator.
DRUPAL_SITE_NAME=
DRUPAL_ADMIN_EMAIL=

# none = an empty site for your community. Leave it as none unless you want
# a site filled with made-up demo content to look around in.
DEMO_MODULE=none

# --- Add these when you have them (the site starts without them) ----------

# Mail (sign-up confirmations, password resets, notifications): a Resend API
# key, and a sender address at a domain verified in your Resend account.
RESEND_API_KEY=
MAIL_FROM=

# The assistant and its search: a Google Gemini API key. Set
# GEMINI_KEY_TIER=paid when the key belongs to a Google Cloud project with
# billing turned on (free-tier keys come with Google's free-tier data terms).
GEMINI_API_KEY=
GEMINI_KEY_TIER=

# Or OpenRouter instead of Gemini: set both lines and leave GEMINI_API_KEY empty.
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# --- Leave these alone unless you know you need them ----------------------

# The image version. Empty = latest.
# IMAGE_TAG=

# Optional web3 features (wallets, treasuries). Off by default.
# WEB3_ENABLED=false
