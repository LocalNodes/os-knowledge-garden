{
    "name": "goalgorilla/social_template",
    "description": "Social project template for composer based Open Social projects.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "goalgorilla/open_social": "~13.0.2",
        "php": "^8.3",
        "monolog/monolog": "^2.3.5",
        "drush/drush": "^13.7",
        "drupal/ai": "~1.4.11",
        "drupal/ai_agents": "dev-1.3.x",
        "drupal/key": "^1.19",
        "drupal/ai_usage_limits": "dev-1.0.x",
        "drupal/ai_file_to_text": "^1.0",
        "drupal/search_api": "^1.40",
        "drupal/gemini_provider": "1.x-dev",
        "league/commonmark": "^2.10.2",
        "drupal/ai_vdb_provider_qdrant": "1.0.x-dev",
        "drupal/siwe_login": "^1.0",
        "drupal/safe_smart_accounts": "^1.0",
        "drupal/group_treasury": "^1.0",
        "kornrunner/keccak": "^1.0",
        "simplito/elliptic-php": "^1.0",
        "brick/math": "^0.17 || ^1.0",
        "symfony/http-client": "^6.4.50",
        "fivefilters/readability.php": "^3.3"
    },
    "require-dev": {
        "drupal/core-dev": "^10.6"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "html/"
            },
            "file-mapping": {
                "[web-root]/robots.txt": {
                    "append": "html/modules/custom/social_ai_indexing/scaffold/robots.append.txt"
                }
            }
        },
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "installer-paths": {
            "html/core": [
                "drupal/core"
            ],
            "html/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "html/profiles/contrib/social": [
                "goalgorilla/open_social"
            ],
            "html/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "html/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "html/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "enable-patching": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/ai": {
                "DeepChat: pass verbose_mode setting in API request body": "patches/ai-deepchat-verbose-mode-passthrough.patch",
                "AI Search: Include citation fields in RAG search output": "patches/ai-search-citation-fields.patch",
                "AI Chatbot: return provider errors as a handled chat error (HTTP 200), not 500": "patches/ai-chatbot-provider-error-200.patch"
            },
            "drupal/gemini_provider": {
                "Add chat_with_tools support, fix role mapping for ai_agents compatibility": "patches/gemini-provider-chat-with-tools-and-roles.patch",
                "Map Gemini API errors (429 quota/rate limit, 401/403, 400, 5xx) to the AI module exception types": "patches/gemini-provider-map-api-errors.patch",
                "Reset content parts per message in chat(); name the call on an empty tool-call turn": "patches/gemini-provider-reset-content-parts.patch"
            },
            "goalgorilla/open_social": {
                "CommentGroupContentFormatter: preserve #comment_type and #comment_display_mode keys": "patches/group-core-comments-missing-comment-preprocess-keys.patch"
            },
            "drupal/ai_vdb_provider_qdrant": {
                "Fix double-MD5 in deleteFromCollection causing silent delete failures": "patches/qdrant-provider-fix-double-md5-delete.patch",
                "Fix filters type hint: accept array from prepareFilters in vectorSearch/querySearch": "patches/qdrant-provider-fix-filters-type-hint.patch"
            }
        },
        "patches-ignore": {
            "goalgorilla/open_social": {
                "drupal/redirect": {
                    "Issue #2991423: Redirection issue when interface language is different from content language": "https://www.drupal.org/files/issues/2025-02-19/redirect-interface_language_different_from_content_language_2991423-22.patch"
                }
            }
        }
    },
    "config": {
        "platform": {
            "ext-gmp": "8.2"
        },
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "zaporylie/composer-drupal-optimizations": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "audit": {
            "ignore": {
                "SA-CONTRIB-2026-236": "drupal/bootstrap 3.34 pinned exactly by goalgorilla/open_social 13.0.x; already locked at this version before this bump; follow-up",
                "SA-CONTRIB-2026-113": "drupal/entity 1.6.0 pinned exactly by goalgorilla/open_social 13.0.x; already locked at this version before this bump; follow-up",
                "SA-CONTRIB-2026-060": "drupal/paragraphs 1.19.0 pinned exactly by goalgorilla/open_social 13.0.x; already locked at this version before this bump; follow-up",
                "SA-CONTRIB-2026-061": "drupal/paragraphs 1.19.0 pinned exactly by goalgorilla/open_social 13.0.x; already locked at this version before this bump; follow-up",
                "SA-CONTRIB-2026-219": "drupal/gin constrained to ^3.0 by goalgorilla/open_social 13.0.x (fix is 4.1.4+); follow-up",
                "PKSA-xwpn-zs9j-6wy5": "webonyx/graphql-php 14.x, required by drupal/graphql 4.9.0, which goalgorilla/open_social 13.0.x pins exactly; already locked before this bump; follow-up",
                "PKSA-sf9j-1gs7-xzvx": "webonyx/graphql-php 14.x, required by drupal/graphql 4.9.0, which goalgorilla/open_social 13.0.x pins exactly; already locked before this bump; follow-up",
                "PKSA-7h5p-prw9-w5nr": "webonyx/graphql-php 14.x, required by drupal/graphql 4.9.0, which goalgorilla/open_social 13.0.x pins exactly; already locked before this bump; follow-up"
            }
        }
    }
}
