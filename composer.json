{
    "name": "goalgorilla/social_template",
    "description": "Social project template for composer based Open Social projects.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "goalgorilla/open_social": "~13.1.0",
        "php": "^8.3",
        "monolog/monolog": "^2.3.5",
        "drush/drush": "^13.7",
        "drupal/ai": "~1.5.2",
        "drupal/ai_agents": "~1.3.5",
        "drupal/key": "^1.19",
        "drupal/ai_usage_limits": "dev-1.0.x",
        "drupal/ai_file_to_text": "^1.0",
        "drupal/search_api": "^1.40",
        "drupal/gemini_provider": "1.x-dev",
        "league/commonmark": "^2.10.2",
        "drupal/ai_vdb_provider_qdrant": "1.0.x-dev",
        "drupal/siwe_login": "1.0.0-beta10",
        "drupal/safe_smart_accounts": "^1.0.0-alpha5@alpha",
        "drupal/group_treasury": "^1.0.0-alpha6@alpha",
        "kornrunner/keccak": "^1.0",
        "simplito/elliptic-php": "^1.0",
        "brick/math": "^0.17 || ^1.0",
        "symfony/http-client": "^6.4.50",
        "fivefilters/readability.php": "^3.3",
        "drupal/ai_provider_openrouter": "1.1.9",
        "drupal/ai_search": "^1.3@alpha",
        "drupal/safe_governance": "^1.0@dev",
        "drupal/gas_sponsor": "^1.0@dev",
        "league/html-to-markdown": "^5.2.3",
        "drupal/calendar_view": "^2.1.10",
        "drupal/poll": "^1.6"
    },
    "require-dev": {
        "drupal/core-dev": "^10.6",
        "drupal/upgrade_status": "^4.3"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "html/"
            },
            "file-mapping": {
                "[web-root]/robots.txt": {
                    "append": "html/modules/custom/social_ai_indexing/scaffold/robots.append.txt"
                }
            }
        },
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "installer-paths": {
            "html/core": [
                "drupal/core"
            ],
            "html/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "html/profiles/contrib/social": [
                "goalgorilla/open_social"
            ],
            "html/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "html/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "html/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "enable-patching": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/ai": {
                "AI Chatbot: return provider errors as a handled chat error (HTTP 200), not 500": "patches/ai-chatbot-provider-error-200.patch"
            },
            "drupal/ai_provider_openrouter": {
                "Log API errors by class and HTTP status, not their message": "patches/ai-provider-openrouter-log-without-text.patch"
            },
            "drupal/ai_search": {
                "AI Search: Include citation fields in RAG search output": "patches/ai-search-citation-fields.patch",
                "Rethrow rate-limit, quota and provider 5xx errors instead of dropping the chunk; keep an item tracked when the VDB client did not finish it": "patches/ai-search-rethrow-provider-limits.patch",
                "Log embedding and RAG errors by class and code, and bad chunks by length and hash, not their text": "patches/ai-search-log-without-text.patch"
            },
            "drupal/gemini_provider": {
                "Add chat_with_tools support, fix role mapping for ai_agents compatibility": "patches/gemini-provider-chat-with-tools-and-roles.patch",
                "Map Gemini API errors (429 quota/rate limit, 401/403, 400, 5xx) to the AI module exception types": "patches/gemini-provider-map-api-errors.patch",
                "Reset content parts per message in chat(); send a neutral mark for a tool-call turn with no text": "patches/gemini-provider-reset-content-parts.patch",
                "Add EmbeddingsCollectionInterface (batchEmbedContents) for drupal/ai 1.5 batch embeddings": "patches/gemini-provider-embeddings-collection.patch",
                "Map roles on copies in chat() so the caller's ChatMessage objects keep their roles": "patches/gemini-provider-map-roles-on-copies.patch"
            },
            "goalgorilla/open_social": {
                "CommentGroupContentFormatter: preserve #comment_type and #comment_display_mode keys": "patches/group-core-comments-missing-comment-preprocess-keys.patch"
            },
            "drupal/ai_vdb_provider_qdrant": {
                "Fix double-MD5 in deleteFromCollection causing silent delete failures": "patches/qdrant-provider-fix-double-md5-delete.patch"
            },
            "drupal/search_api_solr": {
                "Log indexing and search errors by class and code, not Solr's message (it can quote field values and search keys)": "patches/search-api-solr-log-without-text.patch"
            },
            "drupal/calendar_view": {
                "Read stored date and time values as UTC, so events land on the right day": "patches/calendar-view-datetime-utc.patch"
            }
        },
        "patches-ignore": {
            "goalgorilla/open_social": {
                "drupal/simple_oauth": {
                    "Issue #3574042: Classes should not store references to the config as class properties": "https://multiverse.getopensocial.com/download/patches/223/8ae712b1760019f630bceb6f5ef76ef7c675fbe3f7b18bf02c6ebe4bc895cedd/issue-3574042-classes-should-not-store-references-to-the-config-as-class-properties-6-0-9.patch"
                }
            }
        },
        "composer-exit-on-patch-failure": true
    },
    "config": {
        "platform": {
            "ext-gmp": "8.2"
        },
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "zaporylie/composer-drupal-optimizations": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "audit": {
            "abandoned": "report",
            "ignore": {
                "SA-CONTRIB-2026-236": "drupal/bootstrap 3.34 pinned exactly by goalgorilla/open_social 13.1.x (fix is 3.45.0); base theme, accepted until Open Social moves",
                "SA-CONTRIB-2026-219": "drupal/gin constrained to ^3.0 by goalgorilla/open_social 13.1.x (fix is 4.1.4+); admin theme, accepted until Open Social moves"
            }
        }
    }
}
