{#
/**
 * @file
 * A Group's Decisions register: open decisions apart from recorded results.
 *
 * Available variables:
 * - group: the Group.
 * - open: rounds still open, or ended and waiting for their result, newest
 *   first. Each has id and kind ('round' or 'meeting_report', also on the
 *   list item as data-decision-id and data-decision-kind, for other modules),
 *   url, label (a round's short title, the first line of its text),
 *   state_label, visibility_label (what the Group allows now) and lines.
 * - recorded: closed rounds and meeting reports, newest first, the same way.
 * - non_authority_line: the sentence saying a record moves no money, as its
 *   own render element, printed once under the decisions (not on the empty
 *   page, which has no record to describe).
 * - who_decides: while nobody is among the people who decide, one sentence
 *   for the organizer (with a link to that list) or for a member; empty
 *   otherwise. On the empty page it sits in the panel that says what a
 *   decision is, as on the approved canvas.
 * - reads_line: for a member, under that panel, that they can read every
 *   decision shared with the group; empty otherwise.
 *
 * Items hold no decision text past a round's title; each links to its own
 * page.
 */
#}
<section class="decision-register">
  {% if open is empty and recorded is empty %}
    <div class="decision-register__empty">
      <h3>{{ 'No decisions yet'|t }}</h3>
      <p>{{ 'A decision is something this group agrees on together, such as a rule, a plan or how to spend money. One of the people who decide proposes it, and the others respond.'|t }}</p>
      {{ who_decides }}
    </div>
    {{ reads_line }}
  {% else %}
    {{ who_decides }}
    <h2>{{ 'Open decisions'|t }}</h2>
    {% if open is empty %}
      <p>{{ 'Nothing is open right now.'|t }}</p>
    {% else %}
      <ul class="decision-register__open">
        {% for item in open %}
          <li data-decision-id="{{ item.id }}" data-decision-kind="{{ item.kind }}">
            <a href="{{ item.url }}">{{ item.label }}</a>
            <span class="decision-register__state">{{ item.state_label }}</span>
            <span class="decision-register__visibility">{{ item.visibility_label }}</span>
            {% for line in item.lines %}
              <p>{{ line }}</p>
            {% endfor %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
    <h2>{{ 'Recorded results'|t }}</h2>
    {% if recorded is empty %}
      <p>{{ 'No results recorded yet.'|t }}</p>
    {% else %}
      <ul class="decision-register__recorded">
        {% for item in recorded %}
          <li data-decision-id="{{ item.id }}" data-decision-kind="{{ item.kind }}">
            <a href="{{ item.url }}">{{ item.label }}</a>
            <span class="decision-register__state">{{ item.state_label }}</span>
            <span class="decision-register__visibility">{{ item.visibility_label }}</span>
            {% for line in item.lines %}
              <p>{{ line }}</p>
            {% endfor %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
    {{ non_authority_line }}
  {% endif %}
</section>
