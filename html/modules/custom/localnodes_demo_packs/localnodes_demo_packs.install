<?php

/**
 * @file
 * Install hook for the LocalNodes demo packs module.
 */

use Drupal\localnodes_demo_packs\Plugin\DemoContent\PackHowto;

/**
 * Implements hook_install().
 *
 * Creates the "Site guide" topic type the how-to pages carry. It is made
 * here, with a fixed uuid, because the pages' loader finds it by that uuid.
 * The module has no update hook: a site that has the module has had this
 * term since it was enabled.
 */
function localnodes_demo_packs_install(bool $is_syncing = FALSE): void {
  $manager = \Drupal::entityTypeManager();
  if ($manager->getStorage('taxonomy_vocabulary')->load('topic_types') === NULL) {
    return;
  }
  $storage = $manager->getStorage('taxonomy_term');
  if ($storage->loadByProperties(['uuid' => PackHowto::GUIDE_TERM_UUID])) {
    return;
  }
  $storage->create([
    'uuid' => PackHowto::GUIDE_TERM_UUID,
    'vid' => 'topic_types',
    'name' => 'Site guide',
  ])->save();
}
