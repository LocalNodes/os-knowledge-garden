    'add or remove like votes on post_comment of comment',
    'add or remove like votes on topic of node',
    'add photo post entities',
    'add post entities',
    'add post post entities',
    'cancel account',
    'change own username',
    'create album content',
    'create event content',
    'create flexible_group group',
    'create landing_page content',
    'create page content',
    'create topic content',
    'create video_recording_link media',
    'delete own album content',
    'delete own comments',
    'delete own event content',
    'delete own landing_page content',
    'delete own page content',
    'delete own post entities',
    'delete own topic content',
    'delete own video_recording_link media',
    'edit own album content',
    'edit own comments',
    'edit own event content',
    'edit own landing_page content',
    'edit own page content',
    'edit own post entities',
    'edit own topic content',
    'edit own video_recording_link media',
    'flag follow_content',
    'flag follow_term',
    'flag follow_user',
    'flag mute_group_notifications',
    'flag report_comment',
    'flag report_node',
    'flag report_post',
    'override album published option',
    'override event published option',
    'override landing_page published option',
    'override page published option',
    'override topic published option',
    'post comments',
    'request group membership',
    'select account cancellation method',
    'skip comment approval',
    'unflag follow_content',
    'unflag follow_term',
    'unflag follow_user',
    'unflag mute_group_notifications',
    'use ai overview',
    'use select2 autocomplete',
    'use text format basic_html',
    'use text format imported_html',
    'use text format mail_html',
    'use text format simple_text',
    'view any profile profile',
    'view community flexible_group group',
    'view community posts',
    'view events on my profile',
    'view events on other profiles',
    'view group stream page',
    'view groups on my profile',
    'view groups on other profiles',
    'view members flexible_group group',
    'view node.album.field_content_visibility:community content',
    'view node.album.field_content_visibility:public content',
    'view node.event.field_content_visibility:community content',
    'view node.event.field_content_visibility:public content',
    'view node.landing_page.field_content_visibility:community content',
    'view node.landing_page.field_content_visibility:public content',
    'view node.page.field_content_visibility:community content',
    'view node.page.field_content_visibility:public content',
    'view node.topic.field_content_visibility:community content',
    'view node.topic.field_content_visibility:public content',
    'view own unpublished content',
    'view own unpublished post entities',
    'view public flexible_group group',
    'view public posts',
    'view published post entities',
    'view topics on my profile',
    'view topics on other profiles',
  ];
  $site = $role_id === 'sitemanager' ? [
    'access administration pages',
    'access toolbar',
    'administer social site configuration',
    'administer social menu links',
    'access social theme settings',
    'view users',
    'block users',
    'view blocked user',
    'export localnodes site',
    'view network fee account',
  ] : [];
  return array_fill_keys(array_merge($ordinary, $site), TRUE);
}

/** Direct-message policy is unchanged by house access narrowing. */
function _localnodes_platform_house_permission_is_direct_message(string $permission): bool {
  return (bool) preg_match('/private[ _-]?messag/i', $permission);
}

/** Unknown role grants are removed; the metadata is not an authorization list. */
function _localnodes_platform_house_permission_is_broad(string $permission, array $definition = [], string $role_id = 'sitemanager'): bool {
  if (_localnodes_platform_house_permission_is_direct_message($permission)) return FALSE;
  return !isset(_localnodes_platform_house_role_allowed_permissions($role_id)[$permission]);
}

/**
 * Enables same-site iCalendar downloads without outside calendar links.
 *
 * The dependency supplies the plugins but no installed settings object.
 * Create its settings here; a second call with these values saves nothing.
 */
function _localnodes_platform_configure_event_calendar(): void {
  $config = \Drupal::configFactory()->getEditable('social_event_addtocal.settings');
  if ($config->get('enable_add_to_calendar') !== TRUE || $config->get('allowed_calendars') !== ['ical']) {
    $config->set('enable_add_to_calendar', TRUE)
      ->set('allowed_calendars', ['ical'])
      ->save(TRUE);
  }
}

/**
 * Replaces Open Social's stock text on the anonymous front-page hero.
 *
 * social_core_install() creates the hero as a block_content
 * (hero_call_to_action_block, uuid 8bb9d4bb-f182-4afc-b138-8a4b802824e4)
 * reading "This community is powered by Open Social, the plug-and-play
 * community solution for NGOs and semi-governmental organizations": a
 * visitor would meet someone else's product pitch, not the community. It reads
 * instead: heading "Welcome to [site name]",
 * body "Sign in to see what's new, find what the group knows and take part."
 * No crypto words. Its two stored buttons, "Sign up" to the registration page
 * and "Login" to the password page, become one "Sign in" to the log-in page,
 * where the site's sign-in is; with the Web3 stack on, localnodes_web3 swaps
 * it for that sign-in at render time. Open Social's stock photo is left
 * stored (the field is required) and hidden at render time by
 * localnodes_platform_block_content_view_alter().
 *
 * Why this lives in hook_install: the hero is a content entity created by
 * Open Social's own install, so neither config/install nor config/optional can
 * hold it (CLAUDE.md: no entrypoint edits, no update hooks).
 *
 * The heading is the placeholder [site:name]: the text field has no token
 * filter, so localnodes_platform_block_content_view_alter() resolves it to the
 * site's name at render time.
 *
 * Idempotent: a hero that already holds this copy and this button is not
 * saved again, and a site without the hero block is left alone.
 */
function _localnodes_platform_configure_hero_copy() {
  $blocks = \Drupal::entityTypeManager()->getStorage('block_content')
    ->loadByProperties(['uuid' => '8bb9d4bb-f182-4afc-b138-8a4b802824e4']);
  $block = reset($blocks);
  if (!$block || !$block->hasField('field_text_block')) {
    return;
  }
  $changed = FALSE;
  $want = '<h3>Welcome to [site:name]</h3><p>' . htmlspecialchars("Sign in to see what's new, find what the group knows and take part.", ENT_QUOTES | ENT_HTML5) . '</p>';
  if ($block->get('field_text_block')->value !== $want) {
    $block->set('field_text_block', ['value' => $want, 'format' => 'full_html']);
    $changed = TRUE;
  }
  if ($block->hasField('field_call_to_action_link')) {
    $links = $block->get('field_call_to_action_link');
    if ($links->count() !== 1 || $links->uri !== 'internal:/user/login' || $links->title !== 'Sign in') {
      $block->set('field_call_to_action_link', [['uri' => 'internal:/user/login', 'title' => 'Sign in', 'options' => []]]);
      $changed = TRUE;
    }
  }
  if ($changed) {
    $block->save();
  }
}

/**
 * Hides members' email addresses from other members, site-wide.
 *
 * The site terms say: "Other members can't see
 * your email unless you choose to show it on your profile." Open Social ships
 * social_profile.settings:social_profile_show_email TRUE, which shows every
 * member's address on their profile to every other member and locks each
 * member's own "Show my email on my profile" switch on. With it FALSE, only
 * people with "view profile email" (site managers) see an address, and each
 * member's own switch is unlocked and off by default.
 *
 * Why this lives in hook_install: social_profile ships the settings object in
 * its own config/install, created by the Open Social profile before
 * `drush en localnodes_platform`, so a module copy would be pre-existing
 * config (CLAUDE.md).
 *
 * Idempotent: writes only when the value isn't already FALSE, and makes no
 * settings object when social_profile has none.
 */
function _localnodes_platform_hide_profile_email() {
  $config = \Drupal::configFactory()->getEditable('social_profile.settings');
  if (!$config->isNew() && $config->get('social_profile_show_email') !== FALSE) {
    $config->set('social_profile_show_email', FALSE)->save();
  }
}

/**
 * Indexes Open Social's two Solr indexes at the end of each save request.
 *
 * Keyword search should show a new or edited Topic, Event
 * or other content right away, not after the next cron run. Open Social ships
 * social_content and social_all with index_directly FALSE, so search_api
 * only tracks the item and cron indexes it later. With index_directly TRUE,
 * search_api registers the item with search_api.post_request_indexing, which
 * sends it to Solr when the request ends. A Solr error there is caught
 * (SearchApiException) and the item stays tracked for cron, so the save
 * itself still succeeds.
 *
 * Why this lives in hook_install: social_search creates both indexes during
 * `site:install social`, before `drush en localnodes_platform`, so a
 * config/install copy would be pre-existing config (CLAUDE.md). The option is
 * set through the index entity API.
 *
 * Why only these two: they are Solr indexes, so indexing at request end costs
 * one Solr update and no Gemini call. The AI indexes (social_posts,
 * social_comments) keep their own settings, and imports keep deferring
 * them (ImportBatch::DEFERRED_INDEXES).
 *
 * Idempotent: an index that is missing or already has the option is left
 * alone, so a second call saves nothing.
 */
function _localnodes_platform_index_solr_directly() {
  $storage = \Drupal::entityTypeManager()->getStorage('search_api_index');
  foreach (['social_content', 'social_all'] as $index_id) {
    /** @var \Drupal\search_api\IndexInterface|null $index */
    $index = $storage->load($index_id);
    if ($index && !$index->getOption('index_directly')) {
      $index->setOption('index_directly', TRUE)->save();
    }
  }
}

/**
 * Turns on the two Open Social 13.1 group features that ship switched off.
 *
 * Every community gets four group features. Two already are in Open Social
 * 13.1: custom-link online events and group
 * managers editing or deleting members' content. This turns on the other two
 * for flexible_group, the group type every community uses:
 * - Group affiliation: members can name the group as an affiliation on their
 *   profile. The feature itself (social_profile.settings
 *   group_affiliation_status) is on, but 13.1 ships flexible_group with
 *   third_party_settings.social_profile.affiliation_enabled FALSE, and
 *   GroupAffiliation::isGroupAffiliationEnabled() needs at least one group
 *   type with it TRUE (a strict === TRUE check, so the value is a boolean).
 * - The "Request to join" message: social_group_request.settings
 *   allow_customize ships empty, so group managers can't set the request
 *   form's description, default text or required flag. The value is keyed by
 *   group type id, the same shape GroupRequestSettingsForm saves.
 *
 * The labels "Organization" and "Function" on the affiliation fields stay as
 * Open Social ships them; 22.1's copy pass (PLACE-01) owns the wording.
 *
 * Why this lives in hook_install: the group type and the settings object are
 * created by the Open Social profile before `drush en localnodes_platform`,
 * so a config/install copy would be pre-existing config (CLAUDE.md). The
 * group type is changed through the entity API. Its presave hook
 * (GroupAffiliationGroupTypeHooks) only overrides affiliation_enabled from a
 * form POST body, and drush has none, so this write stands.
 *
 * Idempotent: writes only when a value isn't already TRUE, and keeps the
 * allow_customize values of other group types.
 */
function _localnodes_platform_enable_group_features() {
  $module_handler = \Drupal::moduleHandler();

  if ($module_handler->moduleExists('social_profile')) {
    /** @var \Drupal\group\Entity\GroupTypeInterface|null $group_type */
    $group_type = \Drupal::entityTypeManager()
      ->getStorage('group_type')
      ->load('flexible_group');
    if ($group_type && $group_type->getThirdPartySetting('social_profile', 'affiliation_enabled') !== TRUE) {
      $group_type->setThirdPartySetting('social_profile', 'affiliation_enabled', TRUE);
      $group_type->save();
    }
  }

  if ($module_handler->moduleExists('social_group_request')) {
    $config = \Drupal::configFactory()->getEditable('social_group_request.settings');
    $allow_customize = (array) ($config->get('allow_customize') ?? []);
    if (empty($allow_customize['flexible_group'])) {
      $allow_customize['flexible_group'] = TRUE;
      $config->set('allow_customize', $allow_customize)->save();
    }
  }
}

/**
 * Sets the site-wide Gemini token ceiling in ai_usage_limits.
 *
 * The last-resort spend stop across every AI
 * feature. 30,000,000 tokens per 30-day window by default; each instance
 * can change it at /admin/config/ai/usage_limits.
 *
 * All five counters get the same limit, so the total governs. That works
 * around two ai_usage_limits quirks: its check ignores enable_limits and
 * refuses as soon as any counter with usage has a missing or lower limit,
 * and it adds reasoning tokens to the input counter. It counts chat output
 * only, but the check runs before every call to the provider, embeddings
 * included, so at the ceiling vector search and indexing pause too
 * (localnodes_platform's AiCeilingIndexingSubscriber keeps index runs
 * resumable). Per-user, anonymous and per-IP caps are flood control in
 * social_ai_indexing.
 *
 * Why this lives in hook_install: ai_usage_limits ships
 * ai_usage_limits.settings in its own config/install, so a module copy
 * would be pre-existing config. Only writes when providers.gemini is
 * absent, so an admin's change survives.
 */
function _localnodes_platform_configure_ai_usage_limits() {
  $limit = 30000000;
  $config = \Drupal::configFactory()->getEditable('ai_usage_limits.settings');
  if ($config->get('providers.gemini') === NULL) {
    $config->set('providers.gemini', [
      'enable_limits' => TRUE,
      'input_token_usage' => $limit,
      'output_token_usage' => $limit,
      'total_token_usage' => $limit,
      'cached_token_usage' => $limit,
      'reasoning_token_usage' => $limit,
    ]);
    $config->set('retention_days', 30);
    $config->save();
  }

  // ai_usage_limits_cron() loops over this State value without a NULL
  // check, so it warns on every cron run until the first chat call.
  $state = \Drupal::state();
  if (!is_array($state->get('ai_usage_limits'))) {
    $state->set('ai_usage_limits', []);
  }
}

/**
 * Applies the LocalNodes brand palette to socialblue and regenerates its CSS.
 *
 * Stock socialblue fails WCAG AA (primary #29abe2 is 2.62:1 on white), so the
 * distribution ships an AA palette, keeping socialblue rather than adding a
 * sub-theme. The palette lives in this module's
 * config/optional/color.theme.socialblue.yml and is read from there, so the
 * YAML stays the single source of truth.
 *
 * Why this lives in hook_install: drupal/color generates the recoloured
 * brand.css (and the other stylesheets listed in socialblue/color/color.inc)
 * only in its form submit handler, color_scheme_form_submit(). Installing the
 * YAML alone leaves socialblue rendering the stock hexes that brand.css hard
 * codes. So we call that handler with the shipped palette, exactly as the
 * theme settings form would. No entrypoint config:set (CLAUDE.md).
 *
 * Idempotent: if the stored palette already equals the shipped one and the
 * generated stylesheets exist on disk, nothing is regenerated.
 */
function _localnodes_platform_apply_brand_palette() {
  $module_handler = \Drupal::moduleHandler();
  if (!$module_handler->moduleExists('color')
    || !\Drupal::service('theme_handler')->themeExists('socialblue')) {
    return;
  }
  $module_handler->loadInclude('color', 'module');

  $path = \Drupal::service('extension.list.module')->getPath('localnodes_platform')
    . '/config/optional/color.theme.socialblue.yml';
  $shipped = \Drupal\Component\Serialization\Yaml::decode(file_get_contents($path));
  $palette = $shipped['palette'] ?? [];
  if (empty($palette)) {
    return;
  }

  $config = \Drupal::configFactory()->getEditable('color.theme.socialblue');
  $stylesheets = $config->get('stylesheets') ?: [];
  $generated = !empty($stylesheets);
  foreach ($stylesheets as $stylesheet) {
    $generated = $generated && file_exists($stylesheet);
  }
  if ($generated && $config->get('palette') == $palette) {
    return;
  }

  // Write the palette first so color_get_palette() callers (e.g. the
  // social_swiftmail email preprocess) see it even if generation fails.
  $config->set('palette', $palette)->save();

  $info = color_get_info('socialblue');
  if (empty($info)) {
    return;
  }
  $form_state = new \Drupal\Core\Form\FormState();
  $form_state->setValues([
    'theme' => 'socialblue',
    // '' is the "Custom" scheme: use the palette as given.
    'scheme' => '',
    'palette' => $palette,
    'info' => $info,
  ]);
  $form = [];
  color_scheme_form_submit($form, $form_state);

  // color_library_info_alter() swaps the generated files in at library
  // discovery time, so the cached library definitions must be rebuilt.
  \Drupal::service('library.discovery')->clearCachedDefinitions();
}

/**
 * Sets the brand's control and card radius on socialblue.
 *
 * 6px for buttons and form controls, 8px for
 * cards (stock socialblue ships 10 / 5 / 10). improved_theme_settings renders
 * these theme settings into the page head, and social_swiftmail uses them in
 * emails.
 *
 * The values come from the token source (tokens/localnodes.tokens.json) through
 * its generated flat file, tokens/ln-tokens.flat.json: radius.control is the
 * button and form-control radius, radius.card the card radius.
 * Run scripts/tokens/build_tokens.mjs after changing them.
 *
 * Why this lives in hook_install: socialblue ships socialblue.settings in its
 * own config/install, so a module config/install copy would collide with an
 * existing object. Editing it here is the install-time equivalent. Idempotent.
 * If the flat file is missing or unreadable, it logs a warning and leaves
 * socialblue's own radius alone.
 */
function _localnodes_platform_configure_theme_shape() {
  if (!\Drupal::service('theme_handler')->themeExists('socialblue')) {
    return;
  }
  $path = \Drupal::service('extension.list.module')->getPath('localnodes_platform')
    . '/tokens/ln-tokens.flat.json';
  $tokens = is_readable($path) ? json_decode((string) file_get_contents($path), TRUE) : NULL;
  $radius = is_array($tokens) ? ($tokens['radius'] ?? NULL) : NULL;
  // "6px" -> "6": socialblue.settings stores the number without a unit.
  $number = static fn ($value): string => preg_match('/^\d+(?:\.\d+)?/', (string) $value, $m) ? $m[0] : '';
  $control = is_array($radius) ? $number($radius['control'] ?? '') : '';
  $card = is_array($radius) ? $number($radius['card'] ?? '') : '';
  if ($control === '' || $card === '') {
    \Drupal::logger('localnodes_platform')->warning('Token file @path is missing or has no radius.control and radius.card; socialblue keeps its own radius. Run scripts/tokens/build_tokens.mjs.', ['@path' => $path]);
    return;
  }
  $config = \Drupal::configFactory()->getEditable('socialblue.settings');
  $shape = [
    'button_radius' => $control,
    'form_control_radius' => $control,
    'card_radius' => $card,
  ];
  $changed = FALSE;
  foreach ($shape as $key => $value) {
    if ((string) $config->get($key) !== $value) {
      $config->set($key, $value);
      $changed = TRUE;
    }
  }
  if ($changed) {
    $config->save();
  }
}

/**
 * Configures Resend SMTP as the outbound mail transport.
 *
 * The Docker image has no sendmail binary, so Open Social's default `sendmail`
 * transport silently drops all mail (password resets, notifications). We create
 * a transport with id `smtp` pointed at Resend and make it the default.
 *
 * It uses the `dsn` plugin with an `smtps://` DSN on port 2465 so TLS is
 * implicit and mandatory before any SMTP command, AUTH included. The `smtp`
 * plugin always builds an `smtp://` DSN, and Symfony Mailer 6.4 then only
 * negotiates STARTTLS when the server advertises it, so a stripped STARTTLS
 * would send the API key in clear. Port 2465 is Resend's alternative
 * implicit-TLS port; 465 cannot be used because Hetzner blocks outbound 25 and
 * 465 by default (every message timed out after 60 s).
 *
 * Done here (not in config/sync) because this is a distribution: every fresh
 * install gets the transport deterministically. The real DSN, with the API key,
 * is injected at runtime by the $config['symfony_mailer.mailer_transport.smtp']
 * override in settings.php from the RESEND_API_KEY env var; the placeholder
 * below is never used when that variable is set. Idempotent.
 */
function _localnodes_platform_configure_mailer() {
  $storage = \Drupal::entityTypeManager()->getStorage('mailer_transport');

  if (!$storage->load('smtp')) {
    $storage->create([
      'id' => 'smtp',
      'label' => 'Resend SMTP (implicit TLS)',
      'plugin' => 'dsn',
      'configuration' => [
        // Placeholder key only; settings.php replaces the whole DSN at runtime.
        'dsn' => 'smtps://resend:placeholder@smtp.resend.com:2465',
      ],
    ])->save();
  }

  // Make Resend SMTP the default transport.
  \Drupal::configFactory()
    ->getEditable('symfony_mailer.settings')
    ->set('default_transport', 'smtp')
    ->save(TRUE);

  // Sender address. symfony_mailer's default From is the site mail, and
  // site:install leaves it at admin@example.com, which Resend rejects (it only
  // sends from verified domains). MAIL_FROM overrides it per instance (demo and
  // staging instances use noreply@demo.localnodes.xyz).
  \Drupal::configFactory()
    ->getEditable('system.site')
    ->set('mail', getenv('MAIL_FROM') ?: 'noreply@localnodes.xyz')
    ->save(TRUE);
}

/**
 * Takes Open Social's footer out of every mail and sets our mail subjects.
 *
 * Two settings that belong to other modules:
 * - social_swiftmail.settings:remove_open_social_branding TRUE. social_swiftmail
 *   then shows the community's own site name instead of the Open Social link,
 *   and leaves out the slogan and "#MadeToShare" sub-slogan. The object has a
 *   schema but no config/install file, and a copy here would collide with the
 *   object its own install writes (setDefaultDisabledGreetingKeys()).
 * - user.mail subjects, named for the site the person joined:
 *   "Your sign-in link for [site:name]" and, for the two welcome mails (an
 *   organizer-created account and a self-registration without approval),
 *   "Welcome to [site:name]". user.mail comes from core's config/install, so
 *   shipping a copy would be pre-existing config; it is edited here, as the
 *   other install helpers do (CLAUDE.md).
 * - the bodies of the three mails whose link opens the page to choose a
 *   password: the reset, an organizer-created account, and an approved
 *   account. Core's say the member logs in with a password from then on.
 *   A member may sign in another way (the Sign in button), so these say what
 *   the link does: it signs in once and opens that page, and choosing a
 *   password there leaves any other way of signing in as it is. Only the
 *   reset link has core's one-day limit; a first sign-in link has none.
 *   They start without core's "[user:display-name]," line: the mail wrapper
 *   already greets the member by name.
 *
 * The look of the mail (the email--localnodes.html.twig wrapper) is not config;
 * localnodes_platform_theme() registers it. The transport is not touched: that
 * is _localnodes_platform_configure_mailer().
 *
 * Idempotent: a value that is already right is not written, so a second call
 * saves nothing.
 */
function _localnodes_platform_configure_email() {
  if (\Drupal::moduleHandler()->moduleExists('social_swiftmail')) {
    $swiftmail = \Drupal::configFactory()->getEditable('social_swiftmail.settings');
    if ($swiftmail->get('remove_open_social_branding') !== TRUE) {
      $swiftmail->set('remove_open_social_branding', TRUE)->save();
    }
  }

  $subjects = [
    'password_reset' => 'Your sign-in link for [site:name]',
    'register_admin_created' => 'Welcome to [site:name]',
    'register_no_approval_required' => 'Welcome to [site:name]',
  ];
  $mail = \Drupal::configFactory()->getEditable('user.mail');
  $changed = FALSE;
  foreach ($subjects as $key => $subject) {
    if ($mail->get($key . '.subject') !== $subject) {
      $mail->set($key . '.subject', $subject);
      $changed = TRUE;
    }
  }
  foreach (_localnodes_platform_user_mail_bodies() as $key => $body) {
    if ($mail->get($key . '.body') !== $body) {
      $mail->set($key . '.body', $body);
      $changed = TRUE;
    }
  }
  if ($changed) {
    $mail->save();
  }
}

/**
 * The user.mail bodies _localnodes_platform_configure_email() sets.
 *
 * @return array<string, string>
 *   Bodies keyed by user.mail key.
 */
function _localnodes_platform_user_mail_bodies(): array {
  $after = "On the page it opens you can choose a password for your next visits. Any other way you sign in to [site:name] stays as it is.";
  // On Web3 sites the organizer-created welcome carries one more line, above
  // the sign-off. localnodes_web3's install sets the body again once enabled.
  $wallet = \Drupal::moduleHandler()->moduleExists('localnodes_web3')
    ? "You can connect a wallet later from your account page.\n\n" : '';
  return [
    'password_reset' => "Someone asked for a sign-in link for your account at [site:name]. This link signs you in:\n\n[user:one-time-login-url]\n\n" . $after . "\n\nThe link works once. If you did not ask for it, ignore this email; nothing changes on your account.\n\n-- [site:name]",
    'register_admin_created' => "An account at [site:name] was made for you. This link signs you in:\n\n[user:one-time-login-url]\n\n" . $after . "\n\nThe link works once. After that, sign in at [site:login-url]. Your username is [user:name].\n\n" . $wallet . "-- [site:name]",
    'register_no_approval_required' => "Welcome to [site:name]. This link signs you in:\n\n[user:one-time-login-url]\n\n" . $after . "\n\nThe link works once. After that, sign in at [site:login-url]. Your username is [user:account-name].\n\n-- [site:name]",
    'status_activated' => "Your account at [site:name] is now switched on. This link signs you in:\n\n[user:one-time-login-url]\n\n" . $after . "\n\nThe link works once. After that, sign in at [site:login-url]. Your username is [user:account-name].\n\n-- [site:name]",
  ];
}

/**
 * Switches off Open Social's powered-by footer block on the community site.
 *
 * Every page's footer reads
 * "‹community› · a community on LocalNodes · Open source" instead of the
 * Open Social mark and "#MadeToShare by Open Social". The new footer is the
 * socialblue_localnodes_footer block in config/optional (the LocalNodesFooterBlock
 * plugin); this switches off the old one, social_footer's socialblue_footer_powered.
 *
 * It is disabled, not deleted, so a site that wants Open Social's block back
 * can turn it on again in Block layout.
 *
 * The header needs no config: block--system-branding-block--localnodes.html.twig
 * (registered in localnodes_platform_theme()) prints the community's name as
 * text whatever logo the theme settings hold, so no logo setting is written.
 *
 * Why this lives in hook_install: the block belongs to social_footer and is
 * created by the Open Social profile before `drush en localnodes_platform`, so
 * a config/install copy would be pre-existing config (CLAUDE.md).
 *
 * Idempotent: a block that is missing or already off is left alone.
 */
function _localnodes_platform_configure_branding() {
  $block = \Drupal::entityTypeManager()->getStorage('block')->load('socialblue_footer_powered');
  if ($block && $block->status()) {
    $block->disable()->save();
  }
}

/**
 * Grants chatbot API access to anonymous and authenticated users.
 *
 * The 'access deepchat api' permission is required for the AI chatbot widget.
 * We grant it here rather than in config/install because the role entities
 * already exist from the Open Social install profile.
 */
function _localnodes_platform_grant_chatbot_access() {
  $roles = ['anonymous', 'authenticated'];
  foreach ($roles as $role_id) {
    $role = \Drupal\user\Entity\Role::load($role_id);
    if ($role && !$role->hasPermission('access deepchat api')) {
      $role->grantPermission('access deepchat api');
      $role->save();
    }
  }
}

/**
 * Lets members see the community-wide group's tour.
 *
 * Granted here for the same reason as the chatbot: the role already exists
 * from the Open Social install profile.
 */
function _localnodes_platform_grant_tour_access(): void {
  $role = \Drupal\user\Entity\Role::load('authenticated');
  if ($role && !$role->hasPermission('access tour')) {
    $role->grantPermission('access tour');
    $role->save();
  }
}

/**
 * Configures AI provider defaults.
 *
 * Sets Gemini as the default provider for all AI operations, configures
 * the Gemini API key reference, and sets Qdrant as the default VDB with
 * DDEV-compatible connection defaults.
 */
function _localnodes_platform_configure_ai_defaults() {
  $config_factory = \Drupal::configFactory();

  // AI settings: set Gemini as default provider for all operations.
  $ai_config = $config_factory->getEditable('ai.settings');
  $ai_config->set('default_providers', [
    'chat' => [
      'provider_id' => 'gemini',
      'model_id' => 'models/gemini-3.8-flash',
    ],
    'chat_with_complex_json' => [
      'provider_id' => 'gemini',
      'model_id' => 'models/gemini-3.8-flash',
    ],
    'chat_with_image_vision' => [
      'provider_id' => 'gemini',
      'model_id' => 'models/gemini-3.8-flash',
    ],
    'chat_with_structured_response' => [
      'provider_id' => 'gemini',
      'model_id' => 'models/gemini-3.8-flash',
    ],
    'chat_with_tools' => [
      'provider_id' => 'gemini',
      'model_id' => 'models/gemini-3.8-flash',
    ],
    'embeddings' => [
      'provider_id' => 'gemini',
      'model_id' => 'models/gemini-embedding-2',
    ],
    'speech_to_text' => [
      'provider_id' => 'gemini',
      'model_id' => 'models/gemini-3.8-flash',
    ],
    'text_to_image' => [
      'provider_id' => 'gemini',
      'model_id' => 'models/gemini-3.1-flash-image-preview',
    ],
  ]);
  $ai_config->set('default_vdb_provider', 'qdrant');
  $ai_config->save(TRUE);

  // Gemini provider: point to Key module's env-based key.
  $gemini_config = $config_factory->getEditable('gemini_provider.settings');
  $gemini_config->set('api_key', 'gemini_api_key');
  $gemini_config->save(TRUE);

  // Qdrant: set DDEV defaults.
  $qdrant_config = $config_factory->getEditable('ai_vdb_provider_qdrant.settings');
  $qdrant_config->set('host', 'qdrant');
  $qdrant_config->set('port', 6333);
  $qdrant_config->save(TRUE);
}

// _localnodes_platform_apply_env_overrides() removed — environment-specific
// connection config (Solr host/port, Qdrant host/port) is handled by $config[]
// overrides in settings.php (generated by the Docker entrypoint). This is
// strictly superior: runtime-only, doesn't pollute the config DB, and can't
// be accidentally overwritten by config:import --partial.

/**
 * Implements hook_requirements().
 *
 * The data-tier gate: warn-and-provision. A status-report error when a non-demo site
 * hasn't declared a paid Gemini key, plus a check in
 * .github/workflows/provision-instance.yml. No runtime block.
 *
 * Reads two settings from settings.php:
 * - localnodes_ai_data_tier: 'local' on DDEV; off DDEV 'paid' when
 *   GEMINI_KEY_TIER=paid, 'unpaid' for any other value, '' when unset.
 * - localnodes_demo_module: DEMO_MODULE with the entrypoint's default
 *   'none'. A site whose value names a demo module (set and not 'none') holds
 *   fictional content only and is exempt. A missing setting is not exempt.
 *
 * Also warns when CloudflareClientIpMiddleware had to fall back to
 * CF-Connecting-IP in the last 7 days (Traefik's trustedIPs missing).
 */
function localnodes_platform_requirements($phase) {
  $requirements = [];
  if ($phase !== 'runtime') {
    return $requirements;
  }

  $tier = (string) \Drupal\Core\Site\Settings::get('localnodes_ai_data_tier', '');
  $demo = (string) \Drupal\Core\Site\Settings::get('localnodes_demo_module', '');
  $requirement = ['title' => t('Gemini data tier')];

  if ((string) getenv('GEMINI_API_KEY') === '') {
    $has_openrouter_key = (string) getenv('OPENROUTER_API_KEY') !== '';
    $requirement['value'] = $has_openrouter_key ? t('No Gemini key set') : t('The assistant is not set up');
    $requirement['description'] = $has_openrouter_key
      ? t('This row checks Gemini; an OpenRouter key is set separately.')
      : t('Add an AI key and finish the assistant setup when you are ready.');
    $requirement['severity'] = REQUIREMENT_INFO;
  }
  elseif ($tier === 'paid' || $tier === 'local') {
    $requirement['value'] = $tier === 'paid' ? t('Paid key declared') : t('Local DDEV');
    $requirement['severity'] = REQUIREMENT_OK;
  }
  elseif ($demo !== '' && $demo !== 'none') {
    $requirement['value'] = t('Demo site, check skipped');
    $requirement['description'] = t('DEMO_MODULE is %demo, so this site is treated as a demo with made-up content and the paid-key check is skipped. If real members start posting here, set GEMINI_KEY_TIER=paid with a key from a Cloud project that has billing turned on: Google may use content sent with an unpaid key and have people review it.', ['%demo' => $demo]);
    $requirement['severity'] = REQUIREMENT_INFO;
  }
  else {
    $requirement['value'] = t('No paid key declared');
    $requirement['description'] = t("This site sends members' posts and documents to Gemini, but GEMINI_KEY_TIER isn't set to 'paid'. Google may use content sent with an unpaid key and have people review it, and its terms allow only paid keys for users in the EEA, Switzerland and the UK. Use a key from a Google Cloud project with billing turned on, then set GEMINI_KEY_TIER=paid for this instance and redeploy.");
    $requirement['severity'] = REQUIREMENT_ERROR;
  }

  $requirements['localnodes_ai_data_tier'] = $requirement;

  // Set by CloudflareClientIpMiddleware when Traefik sent only Cloudflare's
  // edge address (its forwardedHeaders.trustedIPs setting is missing).
  $last = (int) \Drupal::state()->get('localnodes_platform.cf_connecting_ip_fallback', 0);
  if ($last > 0 && \Drupal::time()->getRequestTime() - $last < 7 * 86400) {
    $requirements['localnodes_platform_cf_fallback'] = [
      'title' => t('Client IP behind Cloudflare'),
      'value' => t('CF-Connecting-IP fallback in use (last seen @date)', ['@date' => \Drupal::service('date.formatter')->format($last)]),
      'description' => t("Traefik is not passing Cloudflare's visitor IPs; using CF-Connecting-IP as a fallback. Check the proxy's forwardedHeaders.trustedIPs."),
      'severity' => REQUIREMENT_WARNING,
    ];
  }
  return $requirements;
}

/**
 * Implements hook_schema().
 */
function localnodes_platform_schema(): array {
  return ['localnodes_site_export' => [
    'description' => 'The current site export and last successful attribution.',
    'fields' => [
      'id' => ['type' => 'varchar', 'length' => 16, 'not null' => TRUE],
      'data' => ['type' => 'blob', 'size' => 'big', 'not null' => TRUE],
    ],
    'primary key' => ['id'],
  ]];
}
