<?php

/**
 * @file
 * Install and update functions for the LocalNodes Platform module.
 */

/**
 * Implements hook_install().
 *
 * Sets default AI provider config and applies environment variable overrides.
 * Dependencies (ai, gemini_provider, ai_vdb_provider_qdrant, etc.) install
 * their own empty/default configs first. This function fills in the values
 * our stack requires (Gemini models, Qdrant connection, Solr connection).
 */
function localnodes_platform_install() {
  if ($role = \Drupal\user\Entity\Role::load('sitemanager')) {
    $role->grantPermission('export localnodes site')->save();
  }
  _localnodes_platform_configure_ai_defaults();
  // Environment-specific overrides (Solr host, Qdrant host, etc.) are handled
  // by $config[] overrides in settings.php, which take effect at runtime without
  // writing to the database. No need to apply them here.
  _localnodes_platform_grant_chatbot_access();
  _localnodes_platform_grant_tour_access();
  _localnodes_platform_configure_mailer();
  // Open Social's footer out of every mail, our own mail subjects in.
  _localnodes_platform_configure_email();
  \Drupal\localnodes_platform\Mail\NoticeMailTemplates::configure();
  // Open Social's "#MadeToShare" footer block off.
  _localnodes_platform_configure_branding();
  // Brand tokens: the socialblue colour scheme and shapes.
  _localnodes_platform_apply_brand_palette();
  _localnodes_platform_configure_theme_shape();
  // The site-wide Gemini token ceiling (ai_usage_limits).
  _localnodes_platform_configure_ai_usage_limits();
  // Group affiliation and the customisable "Request to join"
  // message, on for every community (online-only and place-based).
  _localnodes_platform_enable_group_features();
  _localnodes_platform_configure_event_calendar();
  // Keyword search shows new and edited content without cron.
  _localnodes_platform_index_solr_directly();
  // Members don't see each other's email unless they choose to.
  _localnodes_platform_hide_profile_email();
  // The anonymous front-page hero speaks for the community, not
  // for Open Social.
  _localnodes_platform_configure_hero_copy();
  // The profile's feature hooks have now finished granting their defaults.
  _localnodes_platform_protect_private_groups();
  // The bootstrap account is reserved for deliberate server recovery.
  _localnodes_platform_block_host_account();
}

/** Disables the bootstrap account's browser sign-in after fresh site setup. */
function _localnodes_platform_block_host_account(): void {
  $host = \Drupal::entityTypeManager()->getStorage('user')->load(1);
  if ($host !== NULL && $host->isActive()) {
    $host->block()->save();
  }
}

/** Applies the fresh-install boundary between site roles and house access. */
function _localnodes_platform_protect_private_groups(): void {
  $entities = \Drupal::entityTypeManager();
  $storage = $entities->getStorage('user_role');
  foreach (['sitemanager', 'contentmanager'] as $id) {
    $role = $storage->load($id);
    if ($role === NULL) continue;
    $changed = FALSE;
    if ($role->isAdmin()) {
      $role->set('is_admin', FALSE);
      $changed = TRUE;
    }
    foreach ($role->getPermissions() as $permission) {
      if (_localnodes_platform_house_permission_is_broad($permission, [], $id)) {
        $role->revokePermission($permission);
        $changed = TRUE;
      }
    }
    if ($changed) $role->save();
  }
  if (!$entities->hasDefinition('group_role')) return;
  foreach ($entities->getStorage('group_role')->loadMultiple() as $role) {
    if (!in_array($role->getGlobalRoleId(), ['sitemanager', 'contentmanager'], TRUE)) continue;
    if (!$role->isAdmin() && $role->getPermissions() === []) continue;
    // Ordinary house membership and individual house-manager roles remain.
    $role->set('admin', FALSE);
    $role->set('permissions', []);
    $role->save();
  }
}

