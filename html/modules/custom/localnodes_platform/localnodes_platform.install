<?php

/**
 * @file
 * Install and update functions for the LocalNodes Platform module.
 */

/**
 * Implements hook_install().
 *
 * Sets default AI provider config and applies environment variable overrides.
 * Dependencies (ai, gemini_provider, ai_vdb_provider_qdrant, etc.) install
 * their own empty/default configs first. This function fills in the values
 * our stack requires (Gemini models, Qdrant connection, Solr connection).
 */
function localnodes_platform_install() {
  _localnodes_platform_configure_ai_defaults();
  // Environment-specific overrides (Solr host, Qdrant host, etc.) are handled
  // by $config[] overrides in settings.php, which take effect at runtime without
  // writing to the database. No need to apply them here.
  _localnodes_platform_grant_chatbot_access();
  _localnodes_platform_configure_mailer();
}

/**
 * Configures Resend SMTP as the outbound mail transport.
 *
 * The Docker image has no sendmail binary, so Open Social's default `sendmail`
 * transport silently drops all mail (password resets, notifications). We create
 * a transport with id `smtp` pointed at Resend and make it the default.
 *
 * It uses the `dsn` plugin with an `smtps://` DSN on port 2465 so TLS is
 * implicit and mandatory before any SMTP command, AUTH included. The `smtp`
 * plugin always builds an `smtp://` DSN, and Symfony Mailer 6.4 then only
 * negotiates STARTTLS when the server advertises it, so a stripped STARTTLS
 * would send the API key in clear. Port 2465 is Resend's alternative
 * implicit-TLS port; 465 cannot be used because Hetzner blocks outbound 25 and
 * 465 by default (every message timed out after 60 s).
 *
 * Done here (not in config/sync) because this is a distribution: every fresh
 * install gets the transport deterministically. The real DSN, with the API key,
 * is injected at runtime by the $config['symfony_mailer.mailer_transport.smtp']
 * override in settings.php from the RESEND_API_KEY env var; the placeholder
 * below is never used when that variable is set. Idempotent.
 */
function _localnodes_platform_configure_mailer() {
  $storage = \Drupal::entityTypeManager()->getStorage('mailer_transport');

  if (!$storage->load('smtp')) {
    $storage->create([
      'id' => 'smtp',
      'label' => 'Resend SMTP (implicit TLS)',
      'plugin' => 'dsn',
      'configuration' => [
        // Placeholder key only; settings.php replaces the whole DSN at runtime.
        'dsn' => 'smtps://resend:placeholder@smtp.resend.com:2465',
      ],
    ])->save();
  }

  // Make Resend SMTP the default transport.
  \Drupal::configFactory()
    ->getEditable('symfony_mailer.settings')
    ->set('default_transport', 'smtp')
    ->save(TRUE);

  // Sender address. symfony_mailer's default From is the site mail, and
  // site:install leaves it at admin@example.com, which Resend rejects (it only
  // sends from verified domains). MAIL_FROM overrides it per instance (demo and
  // staging instances use noreply@demo.localnodes.xyz).
  \Drupal::configFactory()
    ->getEditable('system.site')
    ->set('mail', getenv('MAIL_FROM') ?: 'noreply@localnodes.xyz')
    ->save(TRUE);
}

/**
 * Grants chatbot API access to anonymous and authenticated users.
 *
 * The 'access deepchat api' permission is required for the AI chatbot widget.
 * We grant it here rather than in config/install because the role entities
 * already exist from the Open Social install profile.
 */
function _localnodes_platform_grant_chatbot_access() {
  $roles = ['anonymous', 'authenticated'];
  foreach ($roles as $role_id) {
    $role = \Drupal\user\Entity\Role::load($role_id);
    if ($role && !$role->hasPermission('access deepchat api')) {
      $role->grantPermission('access deepchat api');
      $role->save();
    }
  }
}

/**
 * Configures AI provider defaults.
 *
 * Sets Gemini as the default provider for all AI operations, configures
 * the Gemini API key reference, and sets Qdrant as the default VDB with
 * DDEV-compatible connection defaults.
 */
function _localnodes_platform_configure_ai_defaults() {
  $config_factory = \Drupal::configFactory();

  // AI settings: set Gemini as default provider for all operations.
  $ai_config = $config_factory->getEditable('ai.settings');
  $ai_config->set('default_providers', [
    'chat' => [
      'provider_id' => 'gemini',
      'model_id' => 'models/gemini-3-flash-preview',
    ],
    'chat_with_complex_json' => [
      'provider_id' => 'gemini',
      'model_id' => 'models/gemini-3-flash-preview',
    ],
    'chat_with_image_vision' => [
      'provider_id' => 'gemini',
      'model_id' => 'models/gemini-3-flash-preview',
    ],
    'chat_with_structured_response' => [
      'provider_id' => 'gemini',
      'model_id' => 'models/gemini-3-flash-preview',
    ],
    'chat_with_tools' => [
      'provider_id' => 'gemini',
      'model_id' => 'models/gemini-3-flash-preview',
    ],
    'embeddings' => [
      'provider_id' => 'gemini',
      'model_id' => 'models/gemini-embedding-001',
    ],
    'speech_to_text' => [
      'provider_id' => 'gemini',
      'model_id' => 'models/gemini-3-flash-preview',
    ],
    'text_to_image' => [
      'provider_id' => 'gemini',
      'model_id' => 'models/gemini-3.1-flash-image-preview',
    ],
  ]);
  $ai_config->set('default_vdb_provider', 'qdrant');
  $ai_config->save(TRUE);

  // Gemini provider: point to Key module's env-based key.
  $gemini_config = $config_factory->getEditable('gemini_provider.settings');
  $gemini_config->set('api_key', 'gemini_api_key');
  $gemini_config->save(TRUE);

  // Qdrant: set DDEV defaults.
  $qdrant_config = $config_factory->getEditable('ai_vdb_provider_qdrant.settings');
  $qdrant_config->set('host', 'qdrant');
  $qdrant_config->set('port', 6333);
  $qdrant_config->save(TRUE);
}

// _localnodes_platform_apply_env_overrides() removed — environment-specific
// connection config (Solr host/port, Qdrant host/port) is handled by $config[]
// overrides in settings.php (generated by the Docker entrypoint). This is
// strictly superior: runtime-only, doesn't pollute the config DB, and can't
// be accidentally overwritten by config:import --partial.

/**
 * Implements hook_requirements().
 */
function localnodes_platform_requirements($phase) {
  $requirements = [];
  if ($phase !== 'runtime') {
    return $requirements;
  }
  // Set by CloudflareClientIpMiddleware when Traefik sent only Cloudflare's
  // edge address (its forwardedHeaders.trustedIPs setting is missing).
  $last = (int) \Drupal::state()->get('localnodes_platform.cf_connecting_ip_fallback', 0);
  if ($last > 0 && \Drupal::time()->getRequestTime() - $last < 7 * 86400) {
    $requirements['localnodes_platform_cf_fallback'] = [
      'title' => t('Client IP behind Cloudflare'),
      'value' => t('CF-Connecting-IP fallback in use (last seen @date)', ['@date' => \Drupal::service('date.formatter')->format($last)]),
      'description' => t("Traefik is not passing Cloudflare's visitor IPs; using CF-Connecting-IP as a fallback. Check the proxy's forwardedHeaders.trustedIPs."),
      'severity' => REQUIREMENT_WARNING,
    ];
  }
  return $requirements;
}
