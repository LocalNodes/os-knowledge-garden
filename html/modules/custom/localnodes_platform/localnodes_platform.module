/** Implements hook_action_info_alter(). */
function localnodes_platform_action_info_alter(array &$definitions): void {
  foreach ([
    'user_block_user_action' => \Drupal\localnodes_platform\Plugin\Action\BlockMember::class,
    'user_unblock_user_action' => \Drupal\localnodes_platform\Plugin\Action\UnblockMember::class,
  ] as $id => $class) {
    if (isset($definitions[$id])) $definitions[$id]['class'] = $class;
  }
}

/** Implements hook_form_FORM_ID_alter() for the existing People bulk form. */
function localnodes_platform_form_views_form_user_admin_people_page_1_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  $actor = \Drupal::currentUser();
  if ($actor->hasPermission('block users') && !$actor->hasPermission('administer users')) {
    // The profile filters these controls in its last form alter. Finish after
    // all alters so both scoped actions survive without any account-edit grant.
    $form['#after_build'][] = '_localnodes_platform_member_status_actions_after_build';
  }
}

/** Keeps native People controls and their configured labels. */
function _localnodes_platform_member_status_actions_after_build(array $form, FormStateInterface $form_state): array {
  if (!isset($form['header']['user_bulk_form']['action']['#options'])) return $form;
  $select = &$form['header']['user_bulk_form']['action'];
  $options = array_intersect_key($select['#options'], ['' => TRUE]);
  foreach (\Drupal::entityTypeManager()->getStorage('action')->loadMultiple(['user_block_user_action', 'user_unblock_user_action']) as $id => $action) {
    $options[$id] = $action->label();
  }
  $select['#options'] = $options;
  return $form;
}

/** Implements hook_node_access(). */
function localnodes_platform_node_access(EntityInterface $node, $operation, AccountInterface $account) {
  return _localnodes_platform_private_house_access($node, (string) $operation, $account);
}

/** Implements hook_post_access(). */
function localnodes_platform_post_access(EntityInterface $post, $operation, AccountInterface $account) {
  return _localnodes_platform_private_house_access($post, (string) $operation, $account);
}

/** Implements hook_comment_access(). */
function localnodes_platform_comment_access(EntityInterface $comment, $operation, AccountInterface $account) {
  return _localnodes_platform_private_house_access($comment, (string) $operation, $account);
}

/** Prevents site roles and former authors from substituting for membership. */
function _localnodes_platform_private_house_access(EntityInterface $entity, string $operation, AccountInterface $account): \Drupal\Core\Access\AccessResultInterface {
  $result = \Drupal\Core\Access\AccessResult::neutral()->addCacheContexts(['user', 'user.roles', 'user.permissions'])
    ->addCacheTags(['group_content_list', 'group_list'])
    ->addCacheableDependency($entity);
  if ((int) $account->id() === 1 || $entity->isNew()) return $result;
  $entities = \Drupal::entityTypeManager();
  foreach ($entities->getStorage('user_role')->loadMultiple($account->getRoles()) as $role) {
    if ($role->isAdmin()) return $result;
  }
  if ($entity instanceof \Drupal\comment\CommentInterface) {
    $parent = $entity->getCommentedEntity();
    return $parent ? _localnodes_platform_private_house_access($parent, $operation, $account)->addCacheableDependency($entity) : $result;
  }
  if (!$entity instanceof \Drupal\Core\Entity\FieldableEntityInterface) return $result;
  $groups = [];
  $private = FALSE;
  if ($entity->getEntityTypeId() === 'post') {
    $private = $entity->hasField('field_visibility') && (string) $entity->get('field_visibility')->value === '3';
    $gid = $entity->hasField('field_recipient_group') ? $entity->get('field_recipient_group')->target_id : NULL;
    if ($gid && $entities->hasDefinition('group_content')) {
      $group = $entities->getStorage('group')->load($gid);
      if ($group) $groups[] = $group;
    }
  }
  elseif ($entity->getEntityTypeId() === 'node') {
    $private = $entity->hasField('field_content_visibility') && $entity->get('field_content_visibility')->value === 'group';
    if ($entities->hasDefinition('group_content')) {
      foreach ($entities->getStorage('group_content')->loadByEntity($entity) as $relationship) {
        if ($group = $relationship->getGroup()) $groups[] = $group;
      }
    }
  }
  else return $result;
  foreach ($groups as $group) {
    $result->addCacheableDependency($group);
    $private = $private || in_array($group->bundle(), ['closed_group', 'secret_group'], TRUE)
      || ($group->hasField('field_flexible_group_visibility') && $group->get('field_flexible_group_visibility')->value === 'members');
  }
  if (!$private) return $result;
  foreach ($groups as $group) {
    // A page explicitly shared with several houses follows their ordinary
    // grants: current membership in any related house can qualify.
    if ($group->getMember($account)) return $result;
  }
  return \Drupal\Core\Access\AccessResult::forbidden('Private house content requires current house access.')
    ->addCacheableDependency($result);
}

/**
 * Implements hook_page_attachments().
 *
 * Attaches the DES-01 design tokens (localnodes_platform/tokens) and the group
 * tab bar's "More group pages" button (localnodes_platform/group_tabs) on every
 * page rendered by socialblue or another socialbase-derived theme. Admin pages in
 * Gin are left alone: the overrides target socialbase's Bootstrap classes.
 */
function localnodes_platform_page_attachments(array &$attachments) {
  $active_theme = \Drupal::theme()->getActiveTheme();
  if ($active_theme->getName() === 'socialbase'
    || array_key_exists('socialbase', $active_theme->getBaseThemeExtensions())) {
    $attachments['#attached']['library'][] = 'localnodes_platform/tokens';
    $attachments['#attached']['library'][] = 'localnodes_platform/group_tabs';
  }
}

/**
 * Implements hook_block_content_view_alter().
 *
 * Resolves [site:name] in the anonymous hero's text to the site's name at
 * render time (WINDOWS 47, _localnodes_platform_configure_hero_copy()). The
 * text field has no token filter, so this does the one substitution itself.
 * The name is admin input and is escaped. The build depends on system.site,
 * so a rename shows on the next render.
 *
 * It also leaves out Open Social's stock photo (a crowd of strangers on a
 * waterfront, public://homepage-block.jpg), which the hero keeps stored
 * because its image field is required. Without it the block shows on the
 * theme's plain hero background. A community's own image still shows.
 */
function localnodes_platform_block_content_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display): void {
  if ($entity->bundle() !== 'hero_call_to_action_block') {
    return;
  }
  if (isset($build['field_hero_image']) && $entity->hasField('field_hero_image')
    && $entity->get('field_hero_image')->entity?->getFileUri() === 'public://homepage-block.jpg') {
    unset($build['field_hero_image']);
  }
  if (!isset($build['field_text_block'])) {
    return;
  }
  $site = \Drupal::config('system.site');
  $name = Html::escape((string) $site->get('name'));
  foreach (Element::children($build['field_text_block']) as $delta) {
    if (isset($build['field_text_block'][$delta]['#text'])) {
      $build['field_text_block'][$delta]['#text'] = str_replace('[site:name]', $name, $build['field_text_block'][$delta]['#text']);
    }
  }
  CacheableMetadata::createFromRenderArray($build)->addCacheableDependency($site)->applyTo($build);
}

/**
 * Implements hook_css_alter().
 *
 * Core's library parser assigns every module stylesheet to
 * CSS_AGGREGATE_DEFAULT (after hook_library_info_alter() has run, so that hook
 * can't change it), and the asset resolver sorts by group before weight, so a
 * module stylesheet always loads before the theme's whatever its weight.
 * ln-overrides.css has to load after socialblue's brand.css and brand--sky.css
 * (theme weight 700) for its AA overrides to win at equal specificity, and
 * after ln-tokens.css (the generated custom properties it reads), so move both
 * into the theme group here, before the resolver sorts: ln-tokens.css at
 * CSS_THEME + 900, ln-overrides.css at CSS_THEME + 901, and the app look,
 * ln-app-look.css, last at CSS_THEME + 902.
 */
function localnodes_platform_css_alter(array &$css, $assets, $language) {
  $module_path = \Drupal::service('extension.list.module')->getPath('localnodes_platform');
  foreach (['css/ln-tokens.css' => 900, 'css/ln-overrides.css' => 901, 'css/ln-app-look.css' => 902] as $file => $weight) {
    $path = $module_path . '/' . $file;
    if (isset($css[$path])) {
      $css[$path]['group'] = CSS_AGGREGATE_THEME;
      $css[$path]['weight'] = CSS_THEME + $weight;
    }
  }
}

/**
 * Implements hook_mailer_post_render().
 *
 * Never sends mail to reserved test domains (RFC 2606 / RFC 6761), such as the
 * demo users' @localnodes.example addresses. symfony_mailer's "mailer_hooks"
 * adjuster is automatic, so this runs for every email, including legacy
 * MailManager mail such as Open Social's activity notifications.
 */
function localnodes_platform_mailer_post_render(EmailInterface $email): void {
  ReservedRecipientFilter::apply($email, \Drupal::logger('localnodes_platform'));
}

/**
 * Implements hook_mailer_TYPE__SUBTYPE_build() for user status_activated.
 *
 * 23-35 (B-1): when POST /localnodes/activate unblocks a sign-up site's
 * organizer, core's "account activated" notice would go out next to the
 * welcome mail, with a second sign-in link. The welcome mail is the hand-over's
 * one mail, so the notice is skipped, but only while OrganizerActivation is
 * saving that account. Every other activation notice is unchanged.
 */
function localnodes_platform_mailer_user__status_activated_build(EmailInterface $email): void {
  if (\Drupal::service('localnodes_platform.organizer_activation')->isUnblocking()) {
    throw new SkipMailException('The organizer welcome mail replaces the account activated notice.');
  }
}

/**
 * Implements hook_theme().
 *
 * Registers, all from the module so no sub-theme is needed and nothing under
 * html/profiles/contrib is edited:
 * - email__localnodes: the LocalNodes email wrapper (22.1 D-11), a suggestion
 *   of symfony_mailer's `email` theme hook, so socialbase's own
 *   email.html.twig stays untouched (22.1-RESEARCH Pattern 4).
 * - block__system_branding_block__localnodes: the header's name-as-text
 *   (Tom, card 2), a suggestion of the `block` hook.
 * - localnodes_footer: the community site's footer line (Tom, card 11), built
 *   by the LocalNodesFooterBlock plugin.
 * - localnodes_guide: the organizer guide page (23-13), built by GuideController.
 * - localnodes_site_terms: the site terms page (23-26), built by
 *   SiteTermsController.
 * - localnodes_safety_help: the "Hacked or Phished?" help page (22.1-15),
 *   built by SafetyHelpController.
 * - localnodes_get_help: the "Get help" page, built by GetHelpController.
 * - profile__profile__teaser__localnodes and its __sky variant: the member
 *   teaser without keyboard stops inside aria-hidden (22.1 quick task), see
 *   localnodes_platform_theme_suggestions_profile_alter().
 * - group__hero__localnodes__sky: the group header with its one-line
 *   description and buttons, see localnodes_platform_group_view().
 * - node__event__teaser__localnodes__sky: socialblue's event card with the
 *   date tile, see localnodes_platform_theme_suggestions_node_alter().
 */
function localnodes_platform_theme($existing, $type, $theme, $path): array {
  return [
    'node__event__teaser__localnodes__sky' => [
      'base hook' => 'node',
      'template' => 'node--event--teaser--localnodes--sky',
      'path' => $path . '/templates/node',
    ],
    'localnodes_site_export' => [
      'variables' => array_fill_keys(['status', 'parts', 'actions', 'failure', 'requested_by', 'requested_at', 'last_by', 'last_at', 'expires', 'reference'], NULL),
      'template' => 'localnodes-site-export',
    ],
    'email__localnodes' => [
      'base hook' => 'email',
      'template' => 'email--localnodes',
      'path' => $path . '/templates/email',
    ],
    'block__system_branding_block__localnodes' => [
      'base hook' => 'block',
      'template' => 'block--system-branding-block--localnodes',
      'path' => $path . '/templates/block',
    ],
    // 23-04: the organizer welcome mail's body, printed inside the wrapper.
    'localnodes_organizer_welcome' => [
      'variables' => [
        'reset_url' => '',
        'guide_url' => '',
        'sign_in_button' => FALSE,
      ],
      'template' => 'localnodes-organizer-welcome',
      'path' => $path . '/templates/email',
    ],
    // 23-13: the organizer guide at /guide (GuideController).
    'localnodes_guide' => [
      'variables' => [
        'show_fund' => FALSE,
        'show_fees' => FALSE,
        'group_link' => NULL,
        'import_link' => '',
        'fund_link' => '',
        'members_link' => '',
        'get_help_link' => '',
        'get_help_url' => '',
        'assistant_name' => NULL,
        'sign_in_button' => FALSE,
      ],
      'template' => 'localnodes-guide',
      'path' => $path . '/templates',
    ],
    // 23-26: the site terms at /terms (SiteTermsController).
    'localnodes_site_terms' => [
      'variables' => [
        'site_name' => '',
        'version_date' => '',
        'keeps_wallet_address' => FALSE,
      ],
      'template' => 'localnodes-site-terms',
      'path' => $path . '/templates',
    ],
    // 22.1-15: the "Hacked or Phished?" help page (SafetyHelpController).
    'localnodes_safety_help' => [
      'variables' => [
        'seal_911_url' => '',
      ],
      'template' => 'localnodes-safety-help',
      'path' => $path . '/templates',
    ],
    // The "Get help" page (GetHelpController).
    'localnodes_get_help' => [
      'variables' => [
        'help_address' => '',
        'safety_help_url' => '',
        'tour_url' => NULL,
      ],
      'template' => 'localnodes-get-help',
      'path' => $path . '/templates',
    ],
    'localnodes_footer' => [
      'variables' => [
        'site_name' => '',
        'repository_url' => '',
        'mark_url' => '',
        'terms_url' => '',
        'get_help_url' => '',
        'help_url' => '',
      ],
      'template' => 'localnodes-footer',
      'path' => $path . '/templates/footer',
    ],
    // 22.1 quick task: socialbase's member teaser with its two aria-hidden
    // profile links out of the Tab order. socialblue appends "__sky" after
    // every suggestion when its style is sky, so the sky copy (socialblue's
    // own, extending this teaser) is registered too.
    'profile__profile__teaser__localnodes' => [
      'base hook' => 'profile',
      'template' => 'profile--profile--teaser--localnodes',
      'path' => $path . '/templates/profile',
    ],
    'profile__profile__teaser__localnodes__sky' => [
      'base hook' => 'profile',
      'template' => 'profile--profile--teaser--localnodes--sky',
      'path' => $path . '/templates/profile',
    ],
    // The group header with its one-line description and its buttons. Only
    // the sky copy has a template: socialblue appends "__sky" after every
    // suggestion, and the header is socialblue's sky header with two lines
    // added (GroupHeroTemplateTest keeps it in step).
    'group__hero__localnodes__sky' => [
      'base hook' => 'group',
      'template' => 'group--hero--localnodes--sky',
      'path' => $path . '/templates/group',
    ],
  ];
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for email.
 *
 * Appends email__localnodes to every mail's suggestions. It goes last, so it
 * outranks the wrapper the mail's theme ships (socialbase's plain
 * email.html.twig), whichever mail builder made the message: password reset,
 * welcome, notifications, digests, invites, broadcasts and the Web3 mails all
 * render through the one `email` theme hook.
 */
function localnodes_platform_theme_suggestions_email_alter(array &$suggestions, array $variables): void {
  $suggestions[] = 'email__localnodes';
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for block.
 *
 * The site branding block (the header) gets the name-as-text template. Appended
 * last, so it outranks socialbase's block--system-branding-block.html.twig,
 * which prints only the Open Social logo image. No other block is touched.
 */
function localnodes_platform_theme_suggestions_block_alter(array &$suggestions, array $variables): void {
  if (($variables['elements']['#plugin_id'] ?? '') === 'system_branding_block') {
    $suggestions[] = 'block__system_branding_block__localnodes';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for profile.
 *
 * Open Social's socialbase profile--profile--teaser.html.twig puts two links
 * to the member's profile inside aria-hidden (the avatar link and the
 * "Profile: <name>" icon link) and leaves both in the Tab order, so keyboard
 * users land on stops a screen reader is told to ignore (keyboard.spec.ts S8
 * on search results; upstream draft
 * patches/issues/socialbase-profile-teaser-aria-hidden-focusable.md). The
 * member teaser renders from this module's copy instead, which differs only
 * by tabindex="-1" on those two links.
 *
 * A suggestion, not a theme registry alter: the bootstrap base theme's
 * registry alter runs after every module's and points each template its
 * themes ship back at the theme. Appended last, so it outranks the stock
 * teaser; socialblue then adds its "__sky" variant of it.
 *
 * Only for the profile bundle's teaser, only where the active theme ships the
 * stock teaser (so another theme keeps its own profile output), and only for
 * a signed-in viewer: socialbase gives anonymous visitors its own __anonymous
 * teaser, which has no aria-hidden link and which this would outrank.
 */
function localnodes_platform_theme_suggestions_profile_alter(array &$suggestions, array $variables): void {
  $profile = $variables['elements']['#profile'] ?? NULL;
  if (!$profile instanceof EntityInterface || $profile->bundle() !== 'profile' || ($variables['elements']['#view_mode'] ?? '') !== 'teaser') {
    return;
  }
  if (\Drupal::currentUser()->isAnonymous()) {
    return;
  }
  if (!\Drupal::service('theme.registry')->getRuntime()->has('profile__profile__teaser')) {
    return;
  }
  $suggestions[] = 'profile__profile__teaser__localnodes';
}

/**
 * Reads the generated token file, once per request.
 *
 * tokens/ln-tokens.flat.json is rendered from the one token source by
 * scripts/tokens/build_tokens.mjs (22.1-03). A missing or unreadable file
 * gives an empty array and a logged warning, so a mail still goes out (with
 * the browser's default colours) rather than failing.
 *
 * @return array
 *   The decoded file: colour, email, font, radius and space maps.
 */
function _localnodes_platform_flat_tokens(): array {
  static $tokens = NULL;
  if ($tokens === NULL) {
    $path = \Drupal::service('extension.list.module')->getPath('localnodes_platform') . '/tokens/ln-tokens.flat.json';
    $decoded = is_readable($path) ? json_decode((string) file_get_contents($path), TRUE) : NULL;
    if (!is_array($decoded)) {
      \Drupal::logger('localnodes_platform')->warning('Token file @path is missing or not JSON; mail has no brand colours. Run scripts/tokens/build_tokens.mjs.', ['@path' => $path]);
    }
    $tokens = is_array($decoded) ? $decoded : [];
  }
  return $tokens;
}

/**
 * Implements hook_preprocess_HOOK() for email.
 *
 * Gives email--localnodes.html.twig what it needs, all under new names:
 * - ln: the `email` colour roles from the token file (BRAND.md section 9).
 * - ln_radius_card, ln_radius_control, ln_font: shape and type from the token
 *   file. The font stack is cut down to letters, digits, spaces, commas,
 *   hyphens and underscores, because the template prints it inside a <style>
 *   block where HTML escaping would break a quoted family name.
 * - ln_site_name: the community's name (system.site), a plain string the
 *   template autoescapes.
 *
 * It never sets `logo`, `site_name`, `site_slogan` or `site_sub_slogan`:
 * social_swiftmail's preprocess runs after this one (module order is
 * alphabetical) and would overwrite them (22.1-RESEARCH Pitfall 6). There is
 * no logo variable at all, because Tom chose a mail with no images (card 5).
 */
function localnodes_platform_preprocess_email(array &$variables): void {
  $tokens = _localnodes_platform_flat_tokens();
  $variables['ln'] = $tokens['email'] ?? [];
  $variables['ln_radius_card'] = $tokens['radius']['card'] ?? '8px';
  $variables['ln_radius_control'] = $tokens['radius']['control'] ?? '6px';
  $variables['ln_font'] = preg_replace('/[^A-Za-z0-9 ,_-]/', '', (string) ($tokens['font']['sans'] ?? '')) ?: 'sans-serif';
  $variables['ln_site_name'] = (string) \Drupal::config('system.site')->get('name');
}

/**
 * Implements hook_preprocess_HOOK() for group.
 *
 * The group header's footer row (socialblue group--hero--sky.html.twig) holds
 * only the group's location and address. With neither, the row is still
 * printed, empty, and leaves a gap above the tabs; the app look hides it on
 * the class added here (ln-app-look.css). Whether a field shows is read from
 * the built content, the same thing the template prints, so a location the
 * visitor may not see does not count either.
 */
function localnodes_platform_preprocess_group(array &$variables): void {
  if (($variables['view_mode'] ?? '') !== 'hero') {
    return;
  }
  foreach (['field_group_location', 'field_group_address'] as $field) {
    $build = $variables['content'][$field] ?? [];
    if (Element::children($build) && ($build['#access'] ?? TRUE)) {
      return;
    }
  }
  $variables['attributes']['class'][] = 'ln-hero-no-place';
}

/**
 * Implements hook_ENTITY_TYPE_view() for group.
 *
 * The group header (view mode hero) gets the group's description cut to one
 * line and the "New post" and "Invite" buttons a member may use; see
 * GroupHeader. Our header template prints both; a theme without it prints
 * them after the header's fields.
 */
function localnodes_platform_group_view(array &$build, GroupInterface $group, EntityViewDisplayInterface $display, string $view_mode): void {
  if ($view_mode !== 'hero') {
    return;
  }
  $header = \Drupal::service('localnodes_platform.group_header');
  $cache = new CacheableMetadata();
  $summary = $header->summary($group, \Drupal::currentUser(), $cache);
  $build['ln_group_summary'] = [];
  $cache->applyTo($build['ln_group_summary']);
  if ($summary !== '') {
    $build['ln_group_summary'] += [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#attributes' => ['class' => ['ln-group-summary']],
      // Plain text: a description that reads "<shared>" shows those words.
      'text' => ['#plain_text' => $summary],
    ];
  }
  $build['ln_group_actions'] = $header->actions($group);
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for group.
 *
 * The group header (view mode hero) takes our template, which socialblue then
 * suggests as group__hero__localnodes__sky. Other themes have no such
 * template and keep their own. A group type with a header of its own (Open
 * Social's course groups register group__course_basic__hero) keeps it: ours
 * is socialblue's general header with two lines added, not theirs.
 */
function localnodes_platform_theme_suggestions_group_alter(array &$suggestions, array $variables): void {
  if (($variables['elements']['#view_mode'] ?? '') !== 'hero') {
    return;
  }
  $group = $variables['elements']['#group'] ?? NULL;
  if ($group instanceof GroupInterface && \Drupal::service('theme.registry')->getRuntime()->has('group__' . $group->bundle() . '__hero')) {
    return;
  }
  $suggestions[] = 'group__hero__localnodes';
}

/**
 * Implements hook_form_FORM_ID_alter() for user_register_form.
 *
 * 23-26 (ONB-05, D-25; 23-UI-SPEC section 9): a new member agrees to the
 * site terms. The terms_consent box is required and never pre-ticked. It sits
 * in the account fieldset below the fields, so it renders above the "Create
 * new account" button, and its label's words "site terms" link to /terms
 * (added at render time; see TermsConsent::preRender()).
 *
 * Only for people signing themselves up. The same form is the admin's "Add
 * user" page (RegisterForm sets administer_users); a site manager creating an
 * account must not agree to the terms on someone's behalf.
 */
function localnodes_platform_form_user_register_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  if (!empty($form['administer_users']['#value']) || !isset($form['account'])) {
    return;
  }
  $form['account']['terms_consent'] = [
    '#type' => 'checkbox',
    '#title' => t('I agree to the site terms'),
    '#required' => TRUE,
    '#required_error' => t('Agree to the site terms to create your account.'),
    // 0, not FALSE: core's #required check treats only 0 as an unticked box,
    // so a FALSE default would let a programmatic submit through unticked.
    '#default_value' => 0,
    '#weight' => TermsConsent::WEIGHT,
    // A #pre_render set here replaces the checkbox's own (the form builder
    // only fills in missing keys), so keep those and add the link after them.
    '#pre_render' => array_merge(
      \Drupal::service('element_info')->getInfoProperty('checkbox', '#pre_render', []),
      [[TermsConsent::class, 'preRender']],
    ),
  ];
  // Runs after '::save', so the new account has an id to record against.
  $form['actions']['submit']['#submit'][] = [TermsConsent::class, 'recordAgreement'];
  // Re-checks the box after Open Social's validator, which can clear it.
  $form['#after_build'][] = [TermsConsent::class, 'afterBuild'];
  // After a failed submit, focus goes to the error summary.
  $form['#attached']['library'][] = 'localnodes_platform/register_error_focus';
}

/**
 * Implements hook_modules_installed().
 */
function localnodes_platform_modules_installed(array $modules, $is_syncing): void {
  \Drupal\localnodes_platform\Mail\NoticeMailTemplates::configure();
  // Feature installers can add site-role grants after the platform installs.
  \Drupal::moduleHandler()->loadInclude('localnodes_platform', 'install');
  _localnodes_platform_protect_private_groups();
}

/**
 * Implements hook_group_content_predelete().
 *
 * When a membership ends: clears the member's waiting group notices, and
 * notes the departure for the first-sign-in join.
 */
function localnodes_platform_group_content_predelete(\Drupal\group\Entity\GroupRelationshipInterface $relationship): void {
  if ($relationship->getPluginId() === 'group_membership') {
    try {
      \Drupal::service('localnodes_platform.group_notice_cleanup')->remove((int) $relationship->getEntityId(), (int) $relationship->getGroupId());
    }
    catch (\Throwable $exception) {
      // Cleanup must never prevent a member from leaving. Log no member text.
      \Drupal::logger('localnodes_platform')->warning('Waiting group notice cleanup failed (@class, code @code).', [
        '@class' => get_class($exception),
        '@code' => $exception->getCode(),
      ]);
    }
    // Someone who leaves or is removed is never joined back at a first
    // sign-in (see FirstLanding).
    try {
      \Drupal::service('localnodes_platform.first_landing')->recordDeparture((int) $relationship->getEntityId(), (int) $relationship->getGroupId());
    }
    catch (\Throwable $exception) {
      \Drupal::logger('localnodes_platform')->warning('Recording a group departure failed (@class, code @code).', [
        '@class' => get_class($exception),
        '@code' => $exception->getCode(),
      ]);
    }
  }
}

/**
 * Implements hook_user_login().
 *
 * Joins a new member to the community-wide group and, on a sign-in that ends
 * in a page redirect, sets where they land (see InviteLanding).
 *
 * Records how this session signed in (see SignInMethod), so that screens
 * which need the account holder, not only their inbox, can tell.
 */
function localnodes_platform_user_login(UserInterface $account): void {
  $request = \Drupal::request();
  \Drupal::service('localnodes_platform.invite_landing')->afterSignIn($account, $request, \Drupal::routeMatch()->getRouteName());
  if (!$request->hasSession()) {
    return;
  }
  // The account and its wallet address at this moment, so a later check can
  // tell whether the signature that signed in was this account's wallet.
  $address = $account->hasField('field_ethereum_address') ? $account->get('field_ethereum_address')->value : NULL;
  SignInMethod::record($request->getSession(), \Drupal::routeMatch()->getRouteName(), \Drupal::time()->getRequestTime(), (int) $account->id(), is_string($address) ? $address : NULL);
}

/**
 * Implements hook_form_FORM_ID_alter() for user_form.
 *
 * A member invited by email signs in for the first time from the welcome
 * mail, which opens this form to set a password. When they save it, they go
 * on to their invites list instead of staying here.
 */
function localnodes_platform_form_user_form_alter(array &$form, FormStateInterface $form_state, $form_id): void {
  $pass_reset = (bool) $form_state->get('user_pass_reset');
  $form_uid = $form_state->getFormObject()->getEntity()->id();
  if (!InviteLanding::isFirstPasswordForm($pass_reset, $form_uid, \Drupal::currentUser())) {
    return;
  }
  // Added after every alter has run: Open Social's own first-sign-in handler
  // (social_user, which moves itself to run last) sends the member to their
  // profile, and this one has to come after it.
  $form['#after_build'][] = [InviteLanding::class, 'afterBuild'];
}

/**
 * Implements hook_emailfrequency_info_alter().
 */
function localnodes_platform_emailfrequency_info_alter(array &$definitions): void {
  $classes = [
    'immediately' => \Drupal\localnodes_platform\Mail\NoticeImmediateFrequency::class,
    'daily' => \Drupal\localnodes_platform\Mail\NoticeDeferredFrequency::class,
    'weekly' => \Drupal\localnodes_platform\Mail\NoticeDeferredFrequency::class,
  ];
  foreach ($classes as $id => $class) {
    if (isset($definitions[$id])) {
      $definitions[$id]['class'] = $class;
    }
  }
}

/**
 * Implements hook_queue_info_alter().
 */
function localnodes_platform_queue_info_alter(array &$definitions): void {
  if (isset($definitions['activity_digest_worker'])) {
    $definitions['activity_digest_worker']['class'] = \Drupal\localnodes_platform\Mail\NoticeDigestWorker::class;
  }
}

/**
 * Implements hook_group_content_insert().
 */
function localnodes_platform_group_content_insert(\Drupal\group\Entity\GroupRelationshipInterface $relationship): void {
  if ($relationship->getPluginId() === 'group_membership') {
    \Drupal::service('localnodes_platform.group_notice_cleanup')->clearDeparture((int) $relationship->getEntityId(), (int) $relationship->getGroupId());
  }
}


/**
 * Implements hook_file_download().
 */
function localnodes_platform_file_download($uri) {
  $target = rawurldecode((string) \Drupal\Core\StreamWrapper\StreamWrapperManager::getTarget($uri));
  if (preg_match('#(?:^|/)(?:site-exports|\.localnodes)(?:/|$)#', $target)) return -1;
}


/** Implements hook_event_enrollment_access(). */
function localnodes_platform_event_enrollment_access(EntityInterface $enrollment, $operation, AccountInterface $account) {
  return \Drupal::service('localnodes_platform.house_enrollment_access')->entityAccess($enrollment, $account);
}


/** Implements hook_views_plugins_filter_alter(). */
function localnodes_platform_views_plugins_filter_alter(array &$plugins): void {
  if (isset($plugins['activity_filter_personalised_homepage'])) {
    $plugins['activity_filter_personalised_homepage']['class'] = \Drupal\localnodes_platform\Plugin\views\filter\HouseActivityHomepageFilter::class;
  }
}

/**
 * Implements hook_library_info_alter().
 *
 * Core's tour scrolls to each tip with a smooth animation, set in its
 * script settings; our small script before it switches that off for people
 * who ask for reduced motion.
 */
function localnodes_platform_library_info_alter(array &$libraries, string $extension): void {
  if ($extension === 'tour' && isset($libraries['tour'])) {
    $libraries['tour']['dependencies'][] = 'localnodes_platform/tour_reduced_motion';
  }
}

/**
 * Implements hook_tour_tips_alter().
 *
 * Fills the group tour's tips for the community-wide group, and empties them
 * on every other group's page (see GroupTour). The page already carries the
 * group's cache tag, so a renamed group shows its new name here too.
 */
function localnodes_platform_tour_tips_alter(array &$tour_tips, EntityInterface $entity): void {
  if ($entity->id() !== GroupTour::TOUR_ID) {
    return;
  }
  $group = \Drupal::routeMatch()->getParameter('group');
  \Drupal::service('localnodes_platform.group_tour')->alterTips($tour_tips, $group instanceof GroupInterface ? $group : NULL);
}

/**
 * Implements hook_node_view().
 *
 * An event's card (teaser) gets the date tile, printed by
 * node--event--teaser--localnodes--sky.html.twig.
 */
function localnodes_platform_node_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {
  if ($entity->bundle() !== 'event' || $view_mode !== 'teaser') {
    return;
  }
  $build['ln_event_date'] = \Drupal::service('localnodes_platform.event_date_tile')->build($entity);
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for node.
 *
 * An event's card takes the module's template, which adds the date tile. Only
 * its sky variant is registered, so another socialblue style keeps the stock
 * card.
 */
function localnodes_platform_theme_suggestions_node_alter(array &$suggestions, array $variables): void {
  $node = $variables['elements']['#node'] ?? NULL;
  if (!$node instanceof EntityInterface || $node->bundle() !== 'event' || ($variables['elements']['#view_mode'] ?? '') !== 'teaser') {
    return;
  }
  $suggestions[] = 'node__event__teaser__localnodes';
}
