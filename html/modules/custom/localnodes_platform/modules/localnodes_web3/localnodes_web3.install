<?php

/**
 * @file
 * Install/uninstall hooks for the LocalNodes Web3 submodule.
 */

use Drupal\user\Entity\Role;

/**
 * Implements hook_install().
 *
 * The Safe network registry entries this submodule ships come from its
 * config/install directory only; nothing here writes chain data. Per-instance
 * RPC overrides for those entries are $config overrides in settings.php.
 *
 * The one config value set here is the SIWE login RPC default, replacing the
 * upstream placeholder with Pocket Network's free, keyless public portal
 * (https://docs.pocket.network/foundation/api-portal/). It is only a default:
 * operators override it per instance via the ETHEREUM_PROVIDER_URL env var
 * ($config override in settings.php) or the module admin UI. Idempotent.
 *
 * It also lets site managers see the network fee account: gas_sponsor's
 * 'view network fee account', the steward page for the community's sponsor
 * relayer. The grant is made here at install, never in an update hook or
 * the entrypoint. Idempotent.
 *
 * Finally it lets the community's sponsor send fully approved group
 * payments (safe_smart_accounts.settings:sponsored_execution, R5, D-22).
 * safe_smart_accounts ships that setting off and doesn't depend on
 * gas_sponsor, so the distribution turns it on here. Idempotent.
 *
 * Last, it gives safe_governance the platform's name. That contrib module
 * is generic: its outside-payment note reads the name from
 * safe_governance.settings:platform_name and says "this site" while the
 * setting is empty, so the distribution sets its own name here. A name the
 * site already chose is kept. Idempotent.
 *
 * It also gives every member a confirmed email address. siwe_login ships
 * require_email_verification off, so a member who signs in with the button
 * would otherwise get only a made-up "@ethereum.local" address, and no way
 * in by email if the sign-in service is down. Turned on, a member with no
 * real address is asked for one at their next sign-in (see SignInEmail).
 * The two mails siwe_login sends at that step are worded here for members:
 * no wallet words, and a note to open the link in the same browser.
 * Idempotent.
 *
 * And it shows siwe_login's wallet button, so a member whose only way in is
 * a browser wallet (such as MetaMask) can sign in. siwe_login_waap ships it
 * off; on our sites it is offered as a quiet "Use a browser wallet" under
 * the main sign-in (see SignIn). Idempotent.
 *
 * And it puts in the public-record notice members tick before they vote,
 * approve or send a group payment, approve the voting setup or publish a
 * proposal. group_treasury ships the notice empty, which
 * shows nothing and asks nothing; the LocalNodes wording is set here. A
 * notice the site already wrote is kept.
 * Idempotent.
 */
function localnodes_web3_install() {
  _localnodes_web3_configure_siwe_rpc_default();
  _localnodes_web3_grant_network_fee_permission();
  _localnodes_web3_enable_sponsored_execution();
  _localnodes_web3_set_governance_platform_name();
  _localnodes_web3_require_member_email();
  _localnodes_web3_word_welcome_mail();
  _localnodes_web3_show_wallet_button();
  _localnodes_web3_set_public_notice();
}

/**
 * The public-record notice: what becomes public and cannot be erased.
 *
 * Changing the wording asks every member to tick again, since
 * group_treasury keeps a hash of the text beside each tick.
 */
const LOCALNODES_WEB3_PUBLIC_NOTICE = [
  'text' => 'The voting service makes your account ID, vote and proposal text public. Payments publish recipients and amounts on a public test network. These records cannot be erased, even if your account or site is deleted. Practice money has no value.',
  'details' => 'Your account ID is the long address used to identify you to the voting and payment services. When you vote, this site sends that address, your choice and the proposal text to the public voting service, where anyone can read them. If a practice payment is sent, its recipient and amount become public on the test network, a system used for practice payments. These records are kept outside this site. We cannot erase them later, even if your account or the site is deleted. Practice money has no value and cannot be exchanged for real money. Keep private house details out of proposals.',
  'label' => 'I have read what becomes public and what cannot be erased.',
];

/**
 * Sets the LocalNodes public-record notice when the site has none.
 *
 * Does nothing when group_treasury has no notice setting (a version without
 * the notice), or when the site already wrote any part of it.
 */
function _localnodes_web3_set_public_notice(): void {
  $notice = \Drupal::configFactory()->getEditable('group_treasury.public_notice');
  if ($notice->isNew()) {
    return;
  }
  foreach (array_keys(LOCALNODES_WEB3_PUBLIC_NOTICE) as $key) {
    if (trim((string) $notice->get($key)) !== '') {
      return;
    }
  }
  foreach (LOCALNODES_WEB3_PUBLIC_NOTICE as $key => $value) {
    $notice->set($key, $value);
  }
  $notice->save(TRUE);
}

/**
 * Turns on siwe_login_waap's wallet button.
 *
 * Does nothing when siwe_login_waap has no settings, or the button is on.
 */
function _localnodes_web3_show_wallet_button(): void {
  $settings = \Drupal::configFactory()->getEditable('siwe_login_waap.settings');
  if (!$settings->isNew() && $settings->get('show_siwe_wallet_button') !== TRUE) {
    $settings->set('show_siwe_wallet_button', TRUE)->save(TRUE);
  }
}

/**
 * Puts the wallet line into the organizer-created welcome mail.
 *
 * localnodes_platform sets the user mail bodies at its own install, before
 * this module is on; with it on, that body gains one line above the sign-off.
 */
function _localnodes_web3_word_welcome_mail(): void {
  if (!\Drupal::moduleHandler()->moduleExists('localnodes_platform')) {
    return;
  }
  \Drupal::moduleHandler()->loadInclude('localnodes_platform', 'install');
  $body = _localnodes_platform_user_mail_bodies()['register_admin_created'];
  $mail = \Drupal::configFactory()->getEditable('user.mail');
  if ($mail->get('register_admin_created.body') !== $body) {
    $mail->set('register_admin_created.body', $body)->save();
  }
}

/**
 * Asks every member for a real email address, and words siwe_login's mails.
 */
function _localnodes_web3_require_member_email(): void {
  $factory = \Drupal::configFactory();
  $factory->getEditable('siwe_login.settings')
    ->set('require_email_verification', TRUE)
    ->save(TRUE);

  $factory->getEditable('siwe_login.mail')
    ->set('email_verification', [
      'subject' => 'Confirm your email address for [site:name]',
      'body' => "Hello,\n\nTo finish signing in to [site:name], confirm this is your email address. Open this link in the same browser where you signed in:\n\n[siwe:email-verification-url]\n\nThe link works once, for one day. If you did not just sign in to [site:name], you can ignore this email.\n\n-- [site:name]",
    ])
    ->set('account_link', [
      'subject' => 'Add a sign-in to your [site:name] account',
      'body' => "[user:display-name],\n\nSomeone just signed in to [site:name] with the sign-in button and gave this email address. If that was you, open this link in the same browser to add that sign-in to your account here:\n\n[siwe:email-verification-url]\n\nYou can then sign in either way, and you keep everything on your account.\n\nIf it was not you, ignore this email. Nothing changes on your account unless the link is opened. The link works once, for one day.\n\n-- [site:name]",
    ])
    ->save(TRUE);
}

/**
 * Turns on sponsored sending of group payments when gas_sponsor is enabled.
 *
 * Does nothing without gas_sponsor, or when the setting is already on.
 */
function _localnodes_web3_enable_sponsored_execution(): void {
  if (!\Drupal::moduleHandler()->moduleExists('gas_sponsor')) {
    return;
  }
  $settings = \Drupal::configFactory()->getEditable('safe_smart_accounts.settings');
  if ($settings->get('sponsored_execution') !== TRUE) {
    $settings->set('sponsored_execution', TRUE)->save(TRUE);
  }
}

/**
 * Sets the platform name safe_governance shows to LocalNodes when none is set.
 *
 * Does nothing without safe_governance, or when the site already has a name.
 */
function _localnodes_web3_set_governance_platform_name(): void {
  if (!\Drupal::moduleHandler()->moduleExists('safe_governance')) {
    return;
  }
  $settings = \Drupal::configFactory()->getEditable('safe_governance.settings');
  if ((string) $settings->get('platform_name') === '') {
    $settings->set('platform_name', 'LocalNodes')->save(TRUE);
  }
}

/**
 * Grants 'view network fee account' to the site manager role.
 *
 * Open Social's sitemanager role looks after the site, so it sees the
 * account that pays the community's network fees. Does nothing when the
 * role doesn't exist. Idempotent.
 */
function _localnodes_web3_grant_network_fee_permission(): void {
  $role = Role::load('sitemanager');
  if ($role === NULL || $role->hasPermission('view network fee account')) {
    return;
  }
  $role->grantPermission('view network fee account')->save();
}

/**
 * Sets the SIWE login RPC default when no real value is configured.
 */
function _localnodes_web3_configure_siwe_rpc_default() {
  $config_factory = \Drupal::configFactory();

  // SIWE login: ENS resolution + nonce/verification need an RPC for the
  // chain SIWE messages are signed on. Replace the upstream Alchemy
  // placeholder with Pocket's keyless endpoint for that chain. Leave any
  // real value an operator already set untouched.
  $siwe = $config_factory->getEditable('siwe_login.settings');
  $current = (string) $siwe->get('ethereum_provider_url');
  if ($current === '' || str_contains($current, 'YOUR_ALCHEMY_KEY')) {
    $siwe->set('ethereum_provider_url', 'https://eth.api.pocket.network')->save(TRUE);
  }
}
