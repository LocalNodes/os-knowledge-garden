{#
/**
 * @file
 * The organizer welcome mail's body (23-04, UI-SPEC "Mail copy").
 *
 * Printed inside email--localnodes.html.twig, which supplies the community's
 * name, the "Hi <name>," greeting and the footer. The button markup matches
 * what that wrapper styles (.btn .btn-primary).
 *
 * Variables:
 * - reset_url: The one-time sign-in link, built by the mail builder. It is
 *   printed only as this button's href.
 * - guide_url: The site's /guide page.
 * - sign_in_button: Whether the site has the Sign in button (localnodes_web3).
 */
#}
<p class="first-paragraph">{% trans %}Your community's site is ready for you to add your documents.{% endtrans %}</p>
<p>{% trans %}Use the button to sign in. It works once. It opens a page where you choose a password for your next visits.{% endtrans %}</p>
{% if sign_in_button %}
<p>{% trans %}You can also use the site's Sign in button with this same email address. We then email you a link that adds that way of signing in to this account.{% endtrans %}</p>
{% endif %}
<table border="0" cellpadding="0" cellspacing="0" class="btn btn-primary">
  <tr>
    <td align="left">
      <table border="0" cellpadding="0" cellspacing="0">
        <tr>
          <td><a href="{{ reset_url }}" target="_blank">{% trans %}Sign in{% endtrans %}</a></td>
        </tr>
      </table>
    </td>
  </tr>
</table>
<h2>{% trans %}Your first three steps{% endtrans %}</h2>
<ol style="list-style: decimal; padding-left: 1.5em;">
  <li>{% trans %}Sign in.{% endtrans %}</li>
  <li>{% trans %}Open your group.{% endtrans %}</li>
  <li>{% trans %}Upload your first files.{% endtrans %}</li>
</ol>
<p><a href="{{ guide_url }}">{% trans %}Read the organizer guide{% endtrans %}</a></p>
