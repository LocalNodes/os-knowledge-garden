<?php

/**
 * @file
 * Primary module hooks for Social AI Indexing.
 */

use Drupal\Component\Serialization\Json;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Link;
use Drupal\block\BlockInterface;
use Drupal\file\FileInterface;
use Drupal\social_ai_indexing\Plugin\VdbProvider\ThrottledQdrantProvider;
use Drupal\social_ai_indexing\Rag\PermissionAwareRagTool;

/**
 * Implements hook_ai_function_call_info_alter().
 *
 * Swaps the class behind 'ai_search:rag_search' for PermissionAwareRagTool
 * (F-3; D-18 safeguard 2, D-19). Only the class changes: the plugin id,
 * function_name ('ai_search_rag_search') and context definitions stay
 * RagTool's, so the group assistant's tools, tool_settings and
 * tool_usage_limits keep matching, and so does
 * AiAgentEntityWrapper::allRequiredToolsRan().
 *
 * A class swap beats a second plugin id (AI-SPEC §4 step 1): a new id would
 * need its own function_name (getFunctionCallFromFunctionName() returns the
 * first match) and edits to the agent config, and it would leave the stock
 * tool, which hands every retrieved chunk to the LLM without an access
 * check, available to any other agent. Definitions are cached: a cache
 * rebuild picks the swap up.
 */
function social_ai_indexing_ai_function_call_info_alter(array &$definitions): void {
  if (isset($definitions['ai_search:rag_search'])) {
    $definitions['ai_search:rag_search']['class'] = PermissionAwareRagTool::class;
  }
}

/**
 * Implements hook_ai_vdb_provider_info_alter().
 *
 * Swaps the class behind the 'qdrant' VDB plugin for ThrottledQdrantProvider
 * (D-07). The stock QdrantProvider::indexItems() deletes a batch's old points
 * before it embeds anything, so one Gemini 503 in the middle of a batch left
 * the batch with no vectors at all (live, 22-26: Qdrant went from 106 points
 * to 48). The swap changes the class only: the plugin id and the server
 * config that names 'qdrant' stay as they are. A class swap also survives a
 * move of the qdrant provider's commit without a patch reroll.
 */
function social_ai_indexing_ai_vdb_provider_info_alter(array &$definitions): void {
  if (isset($definitions['qdrant'])) {
    $definitions['qdrant']['class'] = ThrottledQdrantProvider::class;
  }
}

/**
 * Implements hook_theme().
 */
function social_ai_indexing_theme(): array {
  return [
    'social_ai_related_content' => [
      'variables' => [
        'items' => [],
      ],
    ],
    'block__social_ai_related_content' => [
      'base hook' => 'block',
    ],
    'social_ai_overview' => [
      'variables' => [
        'query' => '',
      ],
    ],
  ];
}

/**
 * Implements hook_preprocess_block().
 */
function social_ai_indexing_preprocess_block(array &$variables): void {
  if (($variables['elements']['#plugin_id'] ?? '') !== 'social_ai_related_content') {
    return;
  }
  $bundle = $variables['elements']['#configuration']['bundle'] ?? '';
  switch ($bundle) {
    case 'topic':
      $variables['subtitle'] = t('in the community');
      break;
    case 'event':
      $variables['subtitle'] = t('happening soon');
      break;
    default:
      $variables['subtitle'] = t('in the community');
  }
}

/**
 * Implements hook_preprocess_HOOK() for ai_deepchat templates.
 *
 * Injects the current Group ID into DeepChat connect JSON so the RAG
 * search pipeline can scope results to the current Group context.
 *
 * NOTE: We use hook_preprocess_ai_deepchat instead of hook_deepchat_settings
 * because in DeepChatFormBlock::getDeepChatParameters(), hook_deepchat_settings
 * fires at line 634 BEFORE the connect key is set (line 644). By preprocess
 * time, connect exists as a JSON string in $variables['deepchat_settings'].
 *
 * IMPORTANT: Do NOT use early return in this function. The chat settings
 * below (names, error copy, library) must run on ALL pages, not just Group
 * pages.
 */
function social_ai_indexing_preprocess_ai_deepchat(array &$variables): void {
  // --- Group context injection (UI-02) ---
  // Detect current Group from route context using the group module's
  // context provider (not Open Social's CurrentGroupService).
  $group = NULL;
  try {
    $contexts = \Drupal::service('context.repository')
      ->getRuntimeContexts(['@group.group_route_context:group']);
    $group = $contexts['@group.group_route_context:group']->getContextData()->getValue();
  }
  catch (\Exception $e) {
    // Not on a group route or context unavailable — community-wide mode.
  }
  if ($group instanceof \Drupal\group\Entity\GroupInterface) {
    // The connect key is a JSON-encoded string at this point.
    $connect_json = $variables['deepchat_settings']['connect'] ?? NULL;
    if (is_string($connect_json)) {
      $connect = json_decode($connect_json, TRUE);
      if (is_array($connect)) {
        // Add group_id to the contexts sent with each chatbot message.
        $connect['additionalBodyProps']['contexts']['group_id'] = (int) $group->id();
        $variables['deepchat_settings']['connect'] = Json::encode($connect);
      }
    }
  }

  // What the input says: the group's name on a group's pages, the site
  // elsewhere. The style file's look for the placeholder is kept.
  $text_input_json = $variables['deepchat_settings']['textInput'] ?? '{}';
  $text_input = is_string($text_input_json) ? json_decode($text_input_json, TRUE) : [];
  if (!is_array($text_input)) {
    $text_input = [];
  }
  $text_input['placeholder']['text'] = $group instanceof \Drupal\group\Entity\GroupInterface
    // Plain text: the input shows it as text and the attribute is escaped
    // when printed, so the group name must not arrive as "&amp;".
    ? \Drupal\Component\Utility\Html::decodeEntities((string) t('Ask about documents in @group', ['@group' => $group->label()]))
    : (string) t('Ask about pages on this site');
  $variables['deepchat_settings']['textInput'] = Json::encode($text_input);
  $variables['#cache']['contexts'] = Cache::mergeContexts($variables['#cache']['contexts'] ?? [], ['route']);
  if ($group instanceof \Drupal\group\Entity\GroupInterface) {
    $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], $group->getCacheTags());
  }

  // --- LocalNodes chat (UI-SPEC S7) ---
  // Message colours come from the style file
  // (module:social_ai_indexing:localnodes.yml); nothing is hard-coded here.
  $variables['#attached']['library'][] = 'social_ai_indexing/deepchat';

  // The header's name. The block's
  // own label ("AI assistant") is replaced: the default is "LocalNodes
  // LiAIson" on every site, or the name set on Site information. The
  // template prints the visible name (aria-hidden), the spoken name
  // (visually hidden) and the "AI" label, which is template text so no
  // setting removes it.
  /** @var \Drupal\social_ai_indexing\Service\AssistantName $assistant_name */
  $assistant_name = \Drupal::service('social_ai_indexing.assistant_name');
  $variables['settings']['label'] = $assistant_name->label();
  $variables['assistant_spoken_name'] = $assistant_name->spokenLabel();
  $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], $assistant_name->cacheTags());

  // Not set here: DeepChat 'names'. DeepChatFormBlock passes bot_name to
  // DeepChat only in toolbar placement, and in the floating panel a name
  // column beside every message squeezes the answer to a few words a line.
  // The always-visible header (name and AI label) and the first message
  // carry the AI disclosure instead (EU AI Act Art. 50).
  //
  // The template prints every value inside single-quoted attributes, so
  // encode with Json::encode() (it escapes apostrophes, as
  // DeepChatFormBlock does), never plain json_encode().
  // Service error copy for failures that never reach DeepChatApi's JSON
  // error (network failure, gateway error, an empty error string). Errors
  // the API does return use the assistant's error_message, which carries the
  // same copy (UI-SPEC Copywriting Contract, "Chat service error").
  $error_json = $variables['deepchat_settings']['errorMessages'] ?? '{}';
  $error_messages = is_string($error_json) ? json_decode($error_json, TRUE) : [];
  if (!is_array($error_messages)) {
    $error_messages = [];
  }
  $copy = (string) t("Something went wrong and I couldn't answer. Wait a moment, then ask again.");
  $error_messages['displayServiceErrorMessages'] = TRUE;
  $error_messages['overrides']['default'] = $copy;
  $error_messages['overrides']['service'] = $copy;
  $variables['deepchat_settings']['errorMessages'] = Json::encode($error_messages);
}

/**
 * Implements hook_ai_chatbot_style_modules_alter().
 *
 * Lets DeepChatFormBlock discover this module's deepchat_styles/, so the
 * block can use style_file 'module:social_ai_indexing:localnodes.yml'.
 */
function social_ai_indexing_ai_chatbot_style_modules_alter(array &$module_list): void {
  if (!in_array('social_ai_indexing', $module_list, TRUE)) {
    $module_list[] = 'social_ai_indexing';
  }
}

/**
 * Implements hook_theme_registry_alter().
 *
 * Uses this module's ai-deepchat.html.twig for the floating chat: the same
 * markup with the header's nested button moved out and named (UI-SPEC S7,
 * D-05 axe fixes). The toolbar variant (ai_deepchat__toolbar) is untouched.
 */
function social_ai_indexing_theme_registry_alter(array &$theme_registry): void {
  if (isset($theme_registry['ai_deepchat'])) {
    $theme_registry['ai_deepchat']['path'] = \Drupal::service('extension.list.module')->getPath('social_ai_indexing') . '/templates';
    $theme_registry['ai_deepchat']['template'] = 'ai-deepchat';
  }
}

/**
 * Implements hook_page_attachments().
 *
 * Attaches DeepChat link handler and Related Content citation styles globally.
 */
function social_ai_indexing_page_attachments(array &$attachments) {
  $attachments['#attached']['library'][] = 'social_ai_indexing/deepchat-links';
}

/**
 * Implements hook_ENTITY_TYPE_delete() for file entities.
 *
 * Removes the file's stored extracted text, so a deleted file's words do not
 * linger in the key_value store (AI-SPEC 1b, erasure).
 */
function social_ai_indexing_file_delete(FileInterface $file): void {
  \Drupal::service('social_ai_indexing.file_text_store')->delete((int) $file->id());
}

/**
 * Implements hook_form_FORM_ID_alter() for the Site information form.
 *
 * Adds the "Assistant name" field directly under "Site name". Empty means
 * the default, "LocalNodes LiAIson". No permission and no route are added:
 * the form already has its own access (administrators, and site managers
 * through Open Social's
 * 'administer social site configuration').
 */
function social_ai_indexing_form_system_site_information_settings_alter(array &$form, FormStateInterface $form_state): void {
  $stored = \Drupal::config('social_ai_indexing.settings')->get('assistant_name');
  $field = [
    '#type' => 'textfield',
    '#title' => t('Assistant name'),
    '#description' => t('The name at the top of the chat. Leave it empty to use "LocalNodes LiAIson". An "AI" label always shows next to it.'),
    '#maxlength' => 40,
    '#default_value' => is_string($stored) ? $stored : '',
  ];

  // Place the field right after site_name: rebuild the children in key order.
  $details = $form['site_information'] ?? [];
  $form['site_information'] = [];
  foreach ($details as $key => $value) {
    $form['site_information'][$key] = $value;
    if ($key === 'site_name') {
      $form['site_information']['assistant_name'] = $field;
    }
  }
  if (!isset($form['site_information']['assistant_name'])) {
    $form['site_information']['assistant_name'] = $field;
  }
  $form['#submit'][] = 'social_ai_indexing_site_information_submit';
}

/**
 * Submit handler: saves the assistant name, spaces at the ends removed.
 */
function social_ai_indexing_site_information_submit(array &$form, FormStateInterface $form_state): void {
  \Drupal::configFactory()->getEditable('social_ai_indexing.settings')
    ->set('assistant_name', trim((string) $form_state->getValue('assistant_name')))
    ->save();
}

/**
 * Implements hook_form_FORM_ID_alter() for the block form.
 *
 * The chat header's name comes from Site information, not from the DeepChat
 * block's Title. One line under the Title field says so.
 */
function social_ai_indexing_form_block_form_alter(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  $block = method_exists($form_object, 'getEntity') ? $form_object->getEntity() : NULL;
  if (!$block instanceof BlockInterface || $block->getPluginId() !== 'ai_deepchat_block') {
    return;
  }
  $link = Link::createFromRoute(t('Site information'), 'system.site_information_settings')->toString();
  $form['settings']['label']['#description'] = t('The name at the top of the chat is set on @site_information (Assistant name).', [
    '@site_information' => $link,
  ]);
}
