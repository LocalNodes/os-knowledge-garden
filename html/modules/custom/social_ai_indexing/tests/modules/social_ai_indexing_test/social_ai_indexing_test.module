<?php

/**
 * @file
 * Test hooks for social_ai_indexing's test support module.
 */

use Drupal\social_ai_indexing_test\Plugin\VdbProvider\InMemoryQdrantProvider;

/**
 * Implements hook_ai_vdb_provider_info_alter().
 *
 * When state 'social_ai_indexing_test.in_memory_qdrant' is TRUE, the 'qdrant'
 * VDB plugin becomes InMemoryQdrantProvider (a subclass of the shipped
 * ThrottledQdrantProvider that keeps its points in a key_value collection and
 * opens no connection). Hook order is by module name, and
 * 'social_ai_indexing_test' sorts after 'social_ai_indexing', so this alter
 * runs after the shipped class swap and the test sees the shipped
 * indexItems() logic on in-memory storage.
 */
function social_ai_indexing_test_ai_vdb_provider_info_alter(array &$definitions): void {
  if (isset($definitions['qdrant']) && \Drupal::state()->get('social_ai_indexing_test.in_memory_qdrant')) {
    $definitions['qdrant']['class'] = InMemoryQdrantProvider::class;
  }
}

/**
 * Implements hook_ai_search_filterable_rag_query_alter().
 *
 * When state 'social_ai_indexing_test.filterable_throw' is TRUE, fails the
 * filterable retrieval tool's search with an error that repeats the query,
 * the way a search backend's parse error can.
 */
function social_ai_indexing_test_ai_search_filterable_rag_query_alter($query, $tool): void {
  if (\Drupal::state()->get('social_ai_indexing_test.filterable_throw')) {
    throw new \RuntimeException('Fictional backend: cannot parse ' . json_encode($query->getOriginalKeys()));
  }
}

/**
 * Implements hook_ai_provider_info_alter().
 *
 * The echoai provider becomes FailingEchoProvider, which behaves the same
 * unless the scripted LLM was given an exception to throw.
 */
function social_ai_indexing_test_ai_provider_info_alter(array &$definitions): void {
  if (isset($definitions['echoai']) && class_exists('Drupal\ai_test\Plugin\AiProvider\EchoProvider')) {
    $definitions['echoai']['class'] = 'Drupal\social_ai_indexing_test\Plugin\AiProvider\FailingEchoProvider';
  }
}
