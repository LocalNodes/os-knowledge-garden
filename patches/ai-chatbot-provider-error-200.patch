+        // non-OK body and shows a generic failure, so a 500 would hide the
+        // message. The error is logged above.
         return new JsonResponse([
-          'error' => $this->t('An error occurred while processing the request. Please try again later.'),
-        ], 500);
+          'error' => $error_message,
+        ], 200);
 
       }
