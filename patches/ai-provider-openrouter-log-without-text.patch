   /**
+   * Logs a failed API call without the exception's message.
+   *
+   * An API error message can repeat the request, so it may hold the prompt
+   * or the text sent for embedding. The class and HTTP status tell failures
+   * apart without carrying that text.
+   *
+   * @param string $operation
+   *   The call that failed, for the log line.
+   * @param \Throwable $e
+   *   The exception.
+   */
+  protected function logError(string $operation, \Throwable $e): void {
+    $status = $e instanceof ErrorException ? $e->getStatusCode() : $e->getCode();
+    $this->logger->error('OpenRouter @operation error: @class (HTTP @status)', [
+      '@operation' => $operation,
+      '@class' => get_class($e),
+      '@status' => $status,
+    ]);
+  }
