+  /**
+   * The chunks embedded so far on the index's tracked items, summed.
+   *
+   * @param \Drupal\search_api\IndexInterface $index
+   *   The index.
+   *
+   * @return int
+   *   The sum of processed_chunks.
+   */
+  protected function processedChunks(IndexInterface $index): int {
+    $query = $this->database->select('search_api_item', 'sai')
+      ->condition('index_id', $index->id());
+    $query->addExpression('SUM(sai.processed_chunks)', 'chunks');
