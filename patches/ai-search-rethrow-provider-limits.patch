   /**
+   * Tells whether an embeddings error is a provider rate limit or outage.
+   *
+   * A rate limit, a quota error or a provider 5xx error means every further
+   * chunk would fail the same way, and the chunks that did work are not the
+   * whole item. These errors are passed on to the caller (the VDB client),
+   * which can keep the item's old vectors and try again later. Every other
+   * error, a 4xx included, is logged and the chunk dropped, as before.
+   *
+   * @param \Throwable $e
+   *   The exception from the embeddings call.
+   *
+   * @return bool
+   *   TRUE when the exception should be rethrown.
+   */
+  protected static function isProviderLimit(\Throwable $e): bool {
+    return $e instanceof \Drupal\ai\Exception\AiRateLimitException
+      || $e instanceof \Drupal\ai\Exception\AiQuotaException
+      || ($e instanceof \Drupal\ai\Exception\AiRequestErrorException && $e->getCode() >= 500 && $e->getCode() <= 599);
+  }
