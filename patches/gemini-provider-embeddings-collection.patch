   /**
+   * {@inheritdoc}
+   *
+   * All texts go out in one batchEmbedContents request, and the vectors come
+   * back in the same order. Gemini limits the texts one request may hold (100 when this was written); a
+   * caller with more (ai_search sends at most its collection size, 50 by
+   * default) gets Gemini's own error, mapped like any other.
+   */
+  public function embeddingsCollection(EmbeddingsCollectionInput $input, string $model_id, array $tags = []): EmbeddingsCollectionOutput {
+    $prompts = array_values($input->getPrompts());
+    if ($prompts === []) {
+      return new EmbeddingsCollectionOutput([], [], []);
+    }
+    $this->loadClient();
+    try {
+      $response = $this->client->embeddingModel($model_id)->batchEmbedContents(...$prompts);
+    }
+    catch (GeminiErrorException $e) {
+      throw static::mapClientException($e);
+    }
+
+    $vectors = array_map(static fn ($embedding): array => $embedding->values, $response->embeddings);
+    if (count($vectors) !== count($prompts)) {
+      // Never pair a vector with the wrong text.
+      throw new AiResponseErrorException(sprintf('Gemini returned %d embeddings for %d texts.', count($vectors), count($prompts)));
+    }
+    return new EmbeddingsCollectionOutput($vectors, $response->toArray(), []);
+  }
+
