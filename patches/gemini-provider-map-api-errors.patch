+  /**
+   * Maps a Gemini API error to the AI module's typed exceptions.
+   *
+   * Without this, every Gemini error reaches callers as a plain
+   * \Gemini\Exceptions\ErrorException, so consumers such as the chatbot
+   * cannot tell an exhausted quota from a bad request and fall back to their
+   * generic error text. The original exception is kept as the previous one.
+   *
+   * @param \Gemini\Exceptions\ErrorException $e
+   *   The Gemini client exception.
+   *
+   * @return \Exception
+   *   The typed AI exception, or the original one for codes not mapped here.
+   */
+  public static function mapClientException(GeminiErrorException $e): \Exception {
+    $code = $e->getErrorCode();
+    $status = $e->getErrorStatus();
+    $message = $e->getMessage();
+    // Gemini answers 429 RESOURCE_EXHAUSTED both for per-minute rate limits
+    // and for an exhausted (daily or billing) quota; only the latter says
+    // "exceeded your current quota".
+    if ($code === 429 || $status === 'RESOURCE_EXHAUSTED') {
+      return stripos($message, 'exceeded your current quota') !== FALSE
+        ? new AiQuotaException($message, $code, $e)
+        : new AiRateLimitException($message, $code, $e);
+    }
+    if (in_array($code, [401, 403], TRUE) || in_array($status, ['UNAUTHENTICATED', 'PERMISSION_DENIED'], TRUE)) {
+      return new AiSetupFailureException($message, $code, $e);
+    }
+    if ($code === 400 || in_array($status, ['INVALID_ARGUMENT', 'FAILED_PRECONDITION'], TRUE)) {
+      return new AiBadRequestException($message, $code, $e);
+    }
+    if ($code >= 500 || in_array($status, ['UNAVAILABLE', 'INTERNAL', 'DEADLINE_EXCEEDED'], TRUE)) {
+      return new AiRequestErrorException($message, $code, $e);
+    }
+    return $e;
+  }
+
