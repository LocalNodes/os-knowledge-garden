+  /**
+   * Describes a model turn's tool calls, for a turn that has no text.
+   *
+   * @param \Drupal\ai\OperationType\Chat\ChatMessage $message
+   *   A model message.
+   *
+   * @return string
+   *   For example 'Called ai_search_rag_search {"index":"social_posts"}',
+   *   one line per call. Never empty.
+   */
+  protected function describeToolCalls(ChatMessage $message): string {
+    $calls = [];
+    foreach ($message->getTools() ?? [] as $tool) {
+      $function = $tool->getOutputRenderArray()['function'] ?? [];
+      $calls[] = trim('Called ' . ($function['name'] ?? 'a tool') . ' ' . ($function['arguments'] ?? ''));
+    }
+    return $calls ? implode("\n", $calls) : 'Called a tool.';
   }
 
