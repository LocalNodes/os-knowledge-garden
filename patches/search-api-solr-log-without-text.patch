   /**
+   * Logs a failed indexing request and returns the exception to throw.
+   *
+   * Solr's error for a rejected document can quote its field values, which
+   * may be private text. The log line and the new exception name the class
+   * and code only, and the original is not kept as the previous exception,
+   * since callers such as search_api's post-request indexing and drush log
+   * or print whole exception chains.
+   */
+  protected function indexingException(\Throwable $e): SearchApiSolrException {
+    $this->getLogger()->error('%type while indexing (code @code).', [
+      '%type' => get_class($e),
+      '@code' => $e->getCode(),
+    ]);
+    return new SearchApiSolrException(sprintf('%s while indexing (code %s).', get_class($e), $e->getCode()), (int) $e->getCode());
+  }
+
