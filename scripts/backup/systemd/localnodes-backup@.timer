# 09:30 UTC is 02:30 in Colorado in winter, 03:30 in summer: the quiet hours.
# A run missed while the server was off starts when it comes back.
[Unit]
Description=LocalNodes nightly backup timer (%i)

[Timer]
OnCalendar=*-*-* 09:30:00 UTC
RandomizedDelaySec=20m
Persistent=true

[Install]
WantedBy=timers.target
